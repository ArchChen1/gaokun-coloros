# 脚本必须保持 LF，否则在 WSL/bash 里会因 CRLF 报 "bad interpreter"
*.sh text eol=lf
*.py text eol=lf
*.patch text eol=lf

# 会被原样塞进镜像的补丁文件：必须 LF，否则打进去的字节和镜像里那份不一致
# （build/patches/p_vendor_c2.sh 的内容核对会因此失败）
build/patches/**/*.rc text eol=lf
*.rc text eol=lf
*.prop text eol=lf

# 二进制
*.png binary
*.jpg binary
*.img binary
*.zst binary
