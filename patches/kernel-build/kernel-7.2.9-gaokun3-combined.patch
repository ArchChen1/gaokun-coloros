new file mode 100644
index 0000000..7618801
--- /dev/null
+++ b/drivers/input/touchscreen/himax_hx83121a_pen.c
@@ -0,0 +1,1168 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Himax HX83121A cascade slave (active pen) on the HUAWEI MateBook E Go
+ * (gaokun3).
+ *
+ * The panel's touch controller is a pair of HX83121A.  himax-spi drives the
+ * master on spi6 (finger touch); the slave, which senses the M-Pencil, is a
+ * separate SPI device on spi20 (ACPI THPB/HIMX0002).  This driver:
+ *
+ *   1. binds to the slave (the gaokun3 DT enables spi20 and its pins and
+ *      describes the slave), checks the bus and reads the IC ID;
+ *   2. does the two slave writes seen in the Windows THP capture
+ *      (raw_out_sel = 0xF6, rawdata address = 0x5AA5);
+ *   3. reads the 339-byte slave frame (3-byte command + 4-byte IC header +
+ *      TX1/TX2 blocks of anchor row/col + 9x9 s16 grid) by polling, or on the
+ *      GPIO 39 interrupt with use_irq=1;
+ *   4. keeps counters and the last 1024 frames in debugfs (gk3_pen/);
+ *   5. hands every frame whose content changed to userspace through
+ *      /dev/gk3_pen (blocking read / poll, one struct pen_rec per read);
+ *   6. re-initialises the slave when the header stops reading 5a a5 or reads
+ *      keep failing, and, from a 1 s watchdog that follows the panel, when no
+ *      frame arrived for a second while the screen is on.  The slave has no
+ *      reset line: every master reset (screen off/on, himax-spi recovery)
+ *      takes it down too, and an unconfigured slave raises no interrupts at
+ *      all, so in use_irq mode only the watchdog can notice.  The interrupt
+ *      is only requested once an init succeeded (an unconfigured slave could
+ *      hold the level-low line); at boot the driver can probe while himax-spi
+ *      is still reloading the master's firmware, so the first init may fail
+ *      and the watchdog's first good re-init starts the interrupt;
+ *   7. saves wakeups while no pen is around: the slave interrupts ~125 times
+ *      a second even without a pen, so after idle_after_ms with no TX1
+ *      anchor the interrupt is switched off and one frame is read every
+ *      idle_poll_ms instead; the first frame with an anchor switches the
+ *      interrupt back on.  Unread frames are simply overwritten by the
+ *      slave, as with slow polling, and the master keeps running.  Polling
+ *      alone notices a pen too late for a quick tap, so userspace also
+ *      writes to /dev/gk3_pen whenever the pen controller reports activity
+ *      (its reports start as soon as the pen is picked up, before it is
+ *      anywhere near the screen): that switches the interrupt back on at
+ *      once and keeps the slave awake while the pen is in use;
+ *   8. registers the pen's battery as power supply "m-pencil" (scope device,
+ *      so healthd leaves it out of the system battery).  The pen controller
+ *      reports the level (event 0x08, percent) and charging (0x09) to
+ *      userspace, which passes them on with a 3-byte write to /dev/gk3_pen.
+ *      It has no parent device on purpose: Android's EventHub looks for
+ *      batteries in the nearest power_supply directory above an input
+ *      device's sysfs node, which for gk3pend's uinput pen is
+ *      /sys/devices/virtual, so the battery shows up as the stylus's
+ *      (settings, low-battery notice).  The core warns about the missing
+ *      parent once at registration.
+ *
+ * Userspace (gk3pend) turns the frames into a stylus: position, hover and
+ * tilt from the frames, pressure, side double-tap and battery from the pen
+ * controller on USB (12d1:10b8).  That controller holds its reports across
+ * a system suspend until the host talks to it on each interface: usbhid
+ * does it for pressure (HID_QUIRK_IDLE_ON_RESUME), gk3pend for the side
+ * double-tap.  Without it the pen still shows as connected but pressure
+ * stays off.
+ *
+ * It never touches the master, so finger touch is unaffected.
+ *
+ * Bus protocol: same as himax-spi-core.c (himax_spi_read/write,
+ * himax_mcu_register_read/write, himax_mcu_interface_on) with the slave's
+ * function codes F5 (read) / F4 (write) instead of the master's F3 / F2.
+ */
+#define pr_fmt(fmt) KBUILD_MODNAME ": " fmt
+
+#include <linux/debugfs.h>
+#include <linux/delay.h>
+#include <linux/freezer.h>
+#include <linux/interrupt.h>
+#include <linux/kref.h>
+#include <linux/kthread.h>
+#include <linux/ktime.h>
+#include <linux/miscdevice.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/poll.h>
+#include <linux/power_supply.h>
+#include <linux/seq_file.h>
+#include <linux/slab.h>
+#include <linux/spi/spi.h>
+#include <linux/uaccess.h>
+#include <linux/unaligned.h>
+#include <linux/vmalloc.h>
+#include <linux/wait.h>
+#include <linux/workqueue.h>
+
+#include <drm/drm_panel.h>
+
+static int spi_mode = 3;
+module_param(spi_mode, int, 0444);
+MODULE_PARM_DESC(spi_mode, "SPI mode 0..3 (master runs mode 3; ACPI says 0)");
+
+static int speed_hz = 12000000;
+module_param(speed_hz, int, 0444);
+MODULE_PARM_DESC(speed_hz, "SPI clock");
+
+static int poll_hz = 120;
+module_param(poll_hz, int, 0644);
+MODULE_PARM_DESC(poll_hz, "frame polling rate when use_irq=0");
+
+static bool use_irq = true;
+module_param(use_irq, bool, 0444);
+MODULE_PARM_DESC(use_irq, "read frames on the GPIO 39 interrupt (default); 0 = poll at poll_hz");
+
+static bool irq_edge;
+module_param(irq_edge, bool, 0444);
+MODULE_PARM_DESC(irq_edge, "trigger on the falling edge instead of the DT's level-low");
+
+static bool do_init = true;
+module_param(do_init, bool, 0444);
+MODULE_PARM_DESC(do_init, "write raw_out_sel/rawdata_addr after the bus check");
+
+static int idle_after_ms = 10000;	/* longer than a pause while drawing */
+module_param(idle_after_ms, int, 0644);
+MODULE_PARM_DESC(idle_after_ms, "use_irq: switch the interrupt off after this long without a pen and poll instead (0 = never)");
+
+static int idle_poll_ms = 50;
+module_param(idle_poll_ms, int, 0644);
+MODULE_PARM_DESC(idle_poll_ms, "frame polling period while idle");
+
+#define F_READ			0xf5
+#define F_WRITE			0xf4
+
+#define AHB_ADDR_BYTE_0		0x00
+#define AHB_RDATA_BYTE_0	0x08
+#define AHB_ACCESS_DIRECTION	0x0c
+#define AHB_INCR4		0x0d
+#define AHB_CONTI		0x13
+#define AHB_EVENT_STACK		0x30
+
+#define AHB_CMD_CONTI		0x31
+#define AHB_CMD_INCR4		0x10
+#define AHB_CMD_INCR4_ADD_4	0x01
+#define AHB_CMD_DIR_READ	0x00
+
+#define REG_ICID		0x900000d0
+#define REG_RAW_OUT_SEL		0x100072ec	/* EGoTouchRev pfw_op.addr_raw_out_sel */
+#define REG_RAWDATA_ADDR	0x10000000	/* EGoTouchRev psram_op.addr_rawdata_addr */
+
+#define HDR_LEN			3		/* function, command, dummy */
+#define FRAME_LEN		336		/* 4-byte IC header + 166 words */
+#define WORDS_OFF		4
+#define TX2_WORD		83		/* TX1 block = words 0..82 */
+#define GRID			81
+
+#define RING_LEN		1024
+
+/* Header of a slave frame once raw_out_sel/rawdata_addr are in effect. */
+#define HDR_OK(d)		((d)[0] == 0x5a && (d)[1] == 0xa5)
+#define REINIT_AFTER		30		/* bad frames in a row (~250 ms) */
+
+/* Also the record handed out by read() on /dev/gk3_pen. */
+struct pen_rec {
+	u64 t_ns;
+	u32 seq;
+	u32 flags;			/* bit0: TX1 anchor valid */
+	u8 data[FRAME_LEN];
+};
+
+struct gk3_pen {
+	struct kref ref;		/* probe, plus one per open /dev/gk3_pen */
+	struct spi_device *spi;
+	struct mutex lock;		/* SPI access and stats */
+	u8 *xfer;			/* HDR_LEN + FRAME_LEN, kmalloc'd for DMA */
+	struct task_struct *poller;
+	struct dentry *dbg;
+	bool running;
+
+	u8 bus_conti, bus_incr4;
+	u32 icid, raw_out_sel;
+	int bus_ret, init_ret;
+
+	u32 seq, frames, errors, dups, zeros, irqs, hdr_bad;
+	u32 tx1_valid, tx2_valid;
+	u16 tx1_row, tx1_col, tx2_row, tx2_col;
+	s16 tx1_peak, tx1_peak_max, tx2_peak;
+	u8 last[FRAME_LEN];
+	struct pen_rec *ring;
+	u32 ring_head;
+
+	/* newest frame whose content changed, for /dev/gk3_pen */
+	struct pen_rec uniq;
+	u32 uniq_seq;
+	wait_queue_head_t wq;
+	struct miscdevice misc;
+	bool misc_ok, gone;
+
+	u32 bad_frames, reinits;
+	unsigned long last_reinit;
+
+	/* screen state from the panel, and the stall watchdog */
+	struct drm_panel_follower follower;
+	bool follower_ok, panel_on;
+	struct delayed_work watchdog;
+	u32 wd_frames, wd_reinits;
+
+	/* idle: no pen for idle_after_ms, interrupt off, poll every idle_poll_ms */
+	bool idle;
+	unsigned long pen_seen;		/* jiffies of the last frame with a TX1 anchor */
+	u32 pen_frames;			/* complete frames with a TX1 anchor */
+	struct delayed_work idle_poll;
+	u32 idle_enters, idle_polls;
+	u32 hints, hint_wakes;		/* pen-in-use writes, and those that ended idle */
+};
+
+/*
+ * There is one slave; opening the char device finds it here.  Each open
+ * file holds a reference, so the state outlives an unbind (of the parent
+ * SPI controller, say) while gk3pend still has /dev/gk3_pen open.
+ */
+static struct gk3_pen *gk3_pen_dev;
+static DEFINE_MUTEX(gk3_pen_dev_lock);
+
+static void pen_free(struct kref *ref)
+{
+	kfree(container_of(ref, struct gk3_pen, ref));
+}
+
+static void pen_put(void *data)
+{
+	struct gk3_pen *p = data;
+
+	kref_put(&p->ref, pen_free);
+}
+
+/* ---- bus primitives (himax-spi-core.c with F5/F4) ---- */
+
+static int pen_read(struct gk3_pen *p, u8 cmd, u8 *out, u32 len)
+{
+	struct spi_transfer x = {
+		.tx_buf = p->xfer,
+		.rx_buf = p->xfer,
+		.len = HDR_LEN + len,
+	};
+	int ret;
+
+	memset(p->xfer, 0, HDR_LEN + len);
+	p->xfer[0] = F_READ;
+	p->xfer[1] = cmd;
+	ret = spi_sync_transfer(p->spi, &x, 1);
+	if (!ret)
+		memcpy(out, p->xfer + HDR_LEN, len);
+	return ret;
+}
+
+static int pen_write(struct gk3_pen *p, u8 cmd, const u8 *addr, const u8 *data, u32 len)
+{
+	struct spi_transfer x = { .tx_buf = p->xfer };
+	u32 n = 2;
+
+	p->xfer[0] = F_WRITE;
+	p->xfer[1] = cmd;
+	if (addr) {
+		memcpy(p->xfer + n, addr, 4);
+		n += 4;
+	}
+	if (data && len) {
+		memcpy(p->xfer + n, data, len);
+		n += len;
+	}
+	x.len = n;
+	return spi_sync_transfer(p->spi, &x, 1);
+}
+
+static int pen_burst(struct gk3_pen *p, bool add4)
+{
+	u8 v = AHB_CMD_CONTI;
+	int ret;
+
+	ret = pen_write(p, AHB_CONTI, NULL, &v, 1);
+	if (ret)
+		return ret;
+	v = AHB_CMD_INCR4 | (add4 ? AHB_CMD_INCR4_ADD_4 : 0);
+	return pen_write(p, AHB_INCR4, NULL, &v, 1);
+}
+
+static int pen_reg_read(struct gk3_pen *p, u32 addr, u8 *out, u32 len)
+{
+	u8 a[4], dir = AHB_CMD_DIR_READ;
+	int ret;
+
+	put_unaligned_le32(addr, a);
+	ret = pen_burst(p, len > 4);
+	if (ret)
+		return ret;
+	ret = pen_write(p, AHB_ADDR_BYTE_0, a, NULL, 0);
+	if (ret)
+		return ret;
+	ret = pen_write(p, AHB_ACCESS_DIRECTION, NULL, &dir, 1);
+	if (ret)
+		return ret;
+	ret = pen_read(p, AHB_RDATA_BYTE_0, out, len);
+	if (ret)
+		return ret;
+	return pen_burst(p, !(len > 4));
+}
+
+static int pen_reg_write(struct gk3_pen *p, u32 addr, const u8 *data, u32 len)
+{
+	u8 a[4];
+	int ret;
+
+	put_unaligned_le32(addr, a);
+	ret = pen_burst(p, len > 4);
+	if (ret)
+		return ret;
+	ret = pen_write(p, AHB_ADDR_BYTE_0, a, data, len);
+	if (ret)
+		return ret;
+	return pen_burst(p, !(len > 4));
+}
+
+/* himax_mcu_interface_on(): wake the bus, set burst mode, read it back. */
+static int pen_bus_check(struct gk3_pen *p)
+{
+	u8 dummy[4];
+	int i, ret;
+
+	ret = pen_read(p, AHB_RDATA_BYTE_0, dummy, 4);
+	if (ret)
+		return ret;
+	for (i = 0; i < 10; i++) {
+		ret = pen_burst(p, false);
+		if (ret)
+			return ret;
+		ret = pen_read(p, AHB_CONTI, &p->bus_conti, 1);
+		if (ret)
+			return ret;
+		ret = pen_read(p, AHB_INCR4, &p->bus_incr4, 1);
+		if (ret)
+			return ret;
+		if (p->bus_conti == AHB_CMD_CONTI && p->bus_incr4 == AHB_CMD_INCR4)
+			return 0;
+		usleep_range(1000, 1100);
+	}
+	return -EIO;
+}
+
+#define PLOG(v, dev, fmt, ...)					\
+	do {							\
+		if (v)						\
+			dev_info(dev, fmt, ##__VA_ARGS__);	\
+		else						\
+			dev_dbg(dev, fmt, ##__VA_ARGS__);	\
+	} while (0)
+
+static int pen_hw_init(struct gk3_pen *p, bool verbose)
+{
+	struct device *dev = &p->spi->dev;
+	static const u8 raw_sel[4] = { 0xf6, 0x00, 0x00, 0x00 };
+	static const u8 raw_addr[4] = { 0xa5, 0x5a, 0x00, 0x00 };
+	u8 v[4];
+	int i, ret;
+
+	p->bus_ret = pen_bus_check(p);
+	PLOG(verbose, dev, "bus check %d: conti=0x%02x (want 0x31) incr4=0x%02x (want 0x10)\n",
+	     p->bus_ret, p->bus_conti, p->bus_incr4);
+	if (p->bus_ret)
+		return p->bus_ret;
+
+	ret = pen_reg_read(p, REG_ICID, v, 4);
+	p->icid = ret ? 0 : get_unaligned_le32(v);
+	PLOG(verbose, dev, "ICID read %d: 0x%08x (master reads 0x83121a00-ish)\n", ret, p->icid);
+
+	if (!do_init)
+		return 0;
+
+	/* EGoTouchRev himax_switch_data_type(Slave, EGO_RAWDATA): write + verify */
+	ret = -EIO;
+	for (i = 0; i < 50; i++) {
+		if (pen_reg_write(p, REG_RAW_OUT_SEL, raw_sel, 4) == 0 &&
+		    pen_reg_read(p, REG_RAW_OUT_SEL, v, 4) == 0) {
+			p->raw_out_sel = get_unaligned_le32(v);
+			if (v[0] == raw_sel[0]) {
+				ret = 0;
+				break;
+			}
+		}
+		usleep_range(1000, 1100);
+	}
+	PLOG(verbose, dev, "raw_out_sel <- 0xf6: %d after %d tries (read back 0x%08x)\n",
+	     ret, i + 1, p->raw_out_sel);
+	if (ret)
+		return ret;
+
+	/* EGoTouchRev register_write(slave, addr_rawdata_addr, A5 5A 00 00) */
+	ret = pen_reg_write(p, REG_RAWDATA_ADDR, raw_addr, 4);
+	PLOG(verbose, dev, "rawdata_addr <- 0x5aa5: %d\n", ret);
+	return ret;
+}
+
+/* ---- frames ---- */
+
+static s16 grid_peak(const u8 *w, int first_word)
+{
+	s16 peak = S16_MIN;
+	int i;
+
+	for (i = 0; i < GRID; i++) {
+		s16 v = (s16)get_unaligned_le16(w + 2 * (first_word + i));
+
+		if (v > peak)
+			peak = v;
+	}
+	return peak;
+}
+
+static void pen_account(struct gk3_pen *p, const u8 *d, ktime_t t)
+{
+	const u8 *w = d + WORDS_OFF;
+	struct pen_rec *r = &p->ring[p->ring_head];
+	bool valid1, valid2, zero = !memchr_inv(d, 0, FRAME_LEN);
+
+	p->tx1_row = get_unaligned_le16(w);
+	p->tx1_col = get_unaligned_le16(w + 2);
+	p->tx2_row = get_unaligned_le16(w + 2 * TX2_WORD);
+	p->tx2_col = get_unaligned_le16(w + 2 * TX2_WORD + 2);
+	valid1 = !((p->tx1_row & 0xff) == 0xff && (p->tx1_col & 0xff) == 0xff);
+	valid2 = !((p->tx2_row & 0xff) == 0xff && (p->tx2_col & 0xff) == 0xff);
+	p->tx1_peak = grid_peak(w, 2);
+	p->tx2_peak = grid_peak(w, TX2_WORD + 2);
+
+	p->frames++;
+	if (zero)
+		p->zeros++;
+	/*
+	 * Only complete frames go to userspace.  With the pen in range the
+	 * slave runs at ~240 Hz and a read seems to consume the frame: reading
+	 * again before the next one returns zeros, and a read that races the
+	 * update returns a torn buffer.  Both lack the 5a a5 header.
+	 */
+	if (!HDR_OK(d)) {
+		p->hdr_bad++;
+	} else if (!memcmp(d, p->last, FRAME_LEN)) {
+		p->dups++;
+	} else {
+		p->uniq.t_ns = ktime_to_ns(t);
+		p->uniq.seq = p->seq;
+		p->uniq.flags = valid1;
+		memcpy(p->uniq.data, d, FRAME_LEN);
+		WRITE_ONCE(p->uniq_seq, p->uniq_seq + 1);
+		wake_up_interruptible(&p->wq);
+	}
+	if (valid1) {
+		p->tx1_valid++;
+		if (p->tx1_peak > p->tx1_peak_max)
+			p->tx1_peak_max = p->tx1_peak;
+		if (HDR_OK(d)) {
+			p->pen_frames++;
+			p->pen_seen = jiffies;
+		}
+	}
+	if (valid2)
+		p->tx2_valid++;
+	if (HDR_OK(d))
+		memcpy(p->last, d, FRAME_LEN);
+
+	r->t_ns = ktime_to_ns(t);
+	r->seq = p->seq++;
+	r->flags = valid1;
+	memcpy(r->data, d, FRAME_LEN);
+	p->ring_head = (p->ring_head + 1) % RING_LEN;
+
+	if (p->frames <= 3)
+		dev_info(&p->spi->dev, "frame %u hdr %*ph tx1 %04x/%04x peak %d tx2 %04x/%04x\n",
+			 p->frames, 4, d, p->tx1_row, p->tx1_col, p->tx1_peak,
+			 p->tx2_row, p->tx2_col);
+}
+
+static void pen_read_and_account(struct gk3_pen *p)
+{
+	u8 frame[FRAME_LEN];
+	ktime_t t = ktime_get();
+	int ret;
+
+	mutex_lock(&p->lock);
+	ret = pen_read(p, AHB_EVENT_STACK, frame, FRAME_LEN);
+	if (ret)
+		p->errors++;
+	else
+		pen_account(p, frame, t);
+
+	/*
+	 * The slave has no reset line: every master reset (screen off/on,
+	 * himax-spi error recovery) takes it down too and drops our two
+	 * writes.  It then stops prefixing frames with 5a a5 (or stops
+	 * answering), so redo the init, at most once a second.
+	 */
+	if (ret || !HDR_OK(frame))
+		p->bad_frames++;
+	else
+		p->bad_frames = 0;
+	if (p->bad_frames >= REINIT_AFTER && time_after(jiffies, p->last_reinit + HZ)) {
+		p->last_reinit = jiffies;
+		p->reinits++;
+		p->init_ret = pen_hw_init(p, false);
+		dev_info(&p->spi->dev, "re-init #%u after %u bad frames: %d\n",
+			 p->reinits, p->bad_frames, p->init_ret);
+		if (!p->init_ret)
+			p->bad_frames = 0;
+	}
+	mutex_unlock(&p->lock);
+}
+
+static int pen_poll_fn(void *arg)
+{
+	struct gk3_pen *p = arg;
+
+	set_freezable();
+	while (!kthread_should_stop()) {
+		unsigned long period = 1000000UL / clamp(poll_hz, 1, 1000);
+
+		pen_read_and_account(p);
+		usleep_range(period > 200 ? period - 200 : period, period);
+		try_to_freeze();
+	}
+	return 0;
+}
+
+/* ---- idle: interrupt off and slow polling while no pen is in range ---- */
+
+static unsigned long idle_poll_period(void)
+{
+	return msecs_to_jiffies(max(READ_ONCE(idle_poll_ms), 1));
+}
+
+/* p->lock held; idle only ever starts from the interrupt thread */
+static void pen_set_idle(struct gk3_pen *p, bool idle)
+{
+	if (p->idle == idle)
+		return;
+	p->idle = idle;
+	if (idle) {
+		disable_irq_nosync(p->spi->irq);
+		p->idle_enters++;
+		queue_delayed_work(system_freezable_wq, &p->idle_poll, idle_poll_period());
+	} else {
+		enable_irq(p->spi->irq);
+	}
+}
+
+static void pen_idle_poll_fn(struct work_struct *work)
+{
+	struct gk3_pen *p = container_of(to_delayed_work(work), struct gk3_pen, idle_poll);
+	u32 seen;
+
+	mutex_lock(&p->lock);
+	seen = p->pen_frames;
+	mutex_unlock(&p->lock);
+	if (!READ_ONCE(p->idle))
+		return;
+
+	pen_read_and_account(p);
+
+	mutex_lock(&p->lock);
+	p->idle_polls++;
+	if (p->idle) {
+		if (p->pen_frames != seen)
+			pen_set_idle(p, false);
+		else
+			queue_delayed_work(system_freezable_wq, &p->idle_poll, idle_poll_period());
+	}
+	mutex_unlock(&p->lock);
+}
+
+static irqreturn_t pen_irq_fn(int irq, void *arg)
+{
+	struct gk3_pen *p = arg;
+	int after = READ_ONCE(idle_after_ms);
+
+	p->irqs++;
+	pen_read_and_account(p);
+
+	mutex_lock(&p->lock);
+	if (after > 0 && p->panel_on && !p->gone &&
+	    time_after(jiffies, p->pen_seen + msecs_to_jiffies(after)))
+		pen_set_idle(p, true);
+	mutex_unlock(&p->lock);
+	return IRQ_HANDLED;
+}
+
+static int pen_start(struct gk3_pen *p)
+{
+	unsigned long flags = IRQF_ONESHOT | (irq_edge ? IRQF_TRIGGER_FALLING : 0);
+	struct device *dev = &p->spi->dev;
+	int ret;
+
+	/*
+	 * Probe, the watchdog and debugfs reinit can all get here; the lock
+	 * keeps a second caller from starting the interrupt or the poller
+	 * twice.  A handler that fires right away waits for the lock.
+	 */
+	mutex_lock(&p->lock);
+	ret = 0;
+	if (p->running || p->gone)
+		goto out;
+	if (use_irq) {
+		if (p->spi->irq <= 0) {
+			ret = -ENXIO;
+			goto out;
+		}
+		p->pen_seen = jiffies;
+		ret = devm_request_threaded_irq(dev, p->spi->irq, NULL, pen_irq_fn,
+						flags, "himax-hx83121a-pen", p);
+		if (ret)
+			goto out;
+	} else {
+		p->poller = kthread_run(pen_poll_fn, p, "gk3-pen-poll");
+		if (IS_ERR(p->poller)) {
+			ret = PTR_ERR(p->poller);
+			p->poller = NULL;
+			goto out;
+		}
+	}
+	p->running = true;
+	dev_info(dev, "reading frames by %s\n", use_irq ? "interrupt" : "polling");
+out:
+	mutex_unlock(&p->lock);
+	return ret;
+}
+
+/* ---- stall watchdog + panel follower ---- */
+
+#define WD_PERIOD	msecs_to_jiffies(1000)
+
+/*
+ * With the screen on the slave delivers ~130 frames/s even without a pen, so a
+ * second without a single frame means it lost its configuration (a master
+ * reset took it down).  Re-init; if the master is still mid-reset this gets
+ * undone and the next tick tries again.
+ */
+static void pen_watchdog_fn(struct work_struct *work)
+{
+	struct gk3_pen *p = container_of(to_delayed_work(work), struct gk3_pen, watchdog);
+	bool start = false;
+	int ret;
+
+	if (!READ_ONCE(p->panel_on) || READ_ONCE(p->gone))
+		return;
+	mutex_lock(&p->lock);
+	if (p->frames == p->wd_frames) {
+		p->wd_reinits++;
+		p->init_ret = pen_hw_init(p, false);
+		dev_info(&p->spi->dev, "watchdog: no frame for 1 s, re-init #%u: %d\n",
+			 p->wd_reinits, p->init_ret);
+		/* probe skips the interrupt when its init failed (boot race) */
+		start = !p->init_ret && !p->running;
+	}
+	p->wd_frames = p->frames;
+	mutex_unlock(&p->lock);
+	if (start) {
+		ret = pen_start(p);
+		if (ret)
+			dev_err(&p->spi->dev, "start: %d\n", ret);
+	}
+	queue_delayed_work(system_freezable_wq, &p->watchdog, WD_PERIOD);
+}
+
+static int pen_panel_enabled(struct drm_panel_follower *f)
+{
+	struct gk3_pen *p = container_of(f, struct gk3_pen, follower);
+
+	mutex_lock(&p->lock);
+	p->pen_seen = jiffies;
+	mutex_unlock(&p->lock);
+	WRITE_ONCE(p->panel_on, true);
+	mod_delayed_work(system_freezable_wq, &p->watchdog, WD_PERIOD);
+	return 0;
+}
+
+static int pen_panel_disabling(struct drm_panel_follower *f)
+{
+	struct gk3_pen *p = container_of(f, struct gk3_pen, follower);
+
+	WRITE_ONCE(p->panel_on, false);
+	cancel_delayed_work_sync(&p->watchdog);
+	/* back to interrupt mode: with the screen off nothing arrives anyway */
+	mutex_lock(&p->lock);
+	pen_set_idle(p, false);
+	mutex_unlock(&p->lock);
+	cancel_delayed_work_sync(&p->idle_poll);
+	return 0;
+}
+
+static const struct drm_panel_follower_funcs pen_follower_funcs = {
+	.panel_enabled = pen_panel_enabled,
+	.panel_disabling = pen_panel_disabling,
+};
+
+/* ---- debugfs ---- */
+
+static int stats_show(struct seq_file *s, void *unused)
+{
+	struct gk3_pen *p = s->private;
+
+	mutex_lock(&p->lock);
+	seq_printf(s, "spi_mode %d speed_hz %d use_irq %d poll_hz %d running %d irq %d\n",
+		   p->spi->mode & 3, p->spi->max_speed_hz, use_irq, poll_hz, p->running,
+		   p->spi->irq);
+	seq_printf(s, "bus_check %d conti 0x%02x incr4 0x%02x icid 0x%08x init %d raw_out_sel 0x%08x\n",
+		   p->bus_ret, p->bus_conti, p->bus_incr4, p->icid, p->init_ret, p->raw_out_sel);
+	seq_printf(s, "frames %u errors %u dups %u zeros %u irqs %u uniq %u hdr_bad %u bad_run %u reinits %u\n",
+		   p->frames, p->errors, p->dups, p->zeros, p->irqs, p->uniq_seq,
+		   p->hdr_bad, p->bad_frames, p->reinits);
+	seq_printf(s, "tx1_valid %u tx2_valid %u peak_max %d panel_on %d follower %d wd_reinits %u\n",
+		   p->tx1_valid, p->tx2_valid, p->tx1_peak_max, p->panel_on, p->follower_ok,
+		   p->wd_reinits);
+	seq_printf(s, "idle %d enters %u polls %u hints %u hint_wakes %u (idle_after_ms %d idle_poll_ms %d)\n",
+		   p->idle, p->idle_enters, p->idle_polls, p->hints, p->hint_wakes,
+		   idle_after_ms, idle_poll_ms);
+	seq_printf(s, "last hdr %*ph tx1 %04x/%04x peak %d tx2 %04x/%04x peak %d\n",
+		   4, p->last, p->tx1_row, p->tx1_col, p->tx1_peak,
+		   p->tx2_row, p->tx2_col, p->tx2_peak);
+	mutex_unlock(&p->lock);
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(stats);
+
+/* ring: snapshot at open, records oldest to newest */
+static int ring_open(struct inode *inode, struct file *f)
+{
+	struct gk3_pen *p = inode->i_private;
+	size_t rec = sizeof(struct pen_rec);
+	u8 *snap = vmalloc(RING_LEN * rec);
+	u32 i;
+
+	if (!snap)
+		return -ENOMEM;
+	mutex_lock(&p->lock);
+	for (i = 0; i < RING_LEN; i++)
+		memcpy(snap + i * rec, &p->ring[(p->ring_head + i) % RING_LEN], rec);
+	mutex_unlock(&p->lock);
+	f->private_data = snap;
+	return 0;
+}
+
+static ssize_t ring_read(struct file *f, char __user *buf, size_t n, loff_t *pos)
+{
+	return simple_read_from_buffer(buf, n, pos, f->private_data,
+				       RING_LEN * sizeof(struct pen_rec));
+}
+
+static int ring_release(struct inode *inode, struct file *f)
+{
+	vfree(f->private_data);
+	return 0;
+}
+
+static const struct file_operations ring_fops = {
+	.owner = THIS_MODULE,
+	.open = ring_open,
+	.read = ring_read,
+	.release = ring_release,
+	.llseek = default_llseek,
+};
+
+static ssize_t reinit_write(struct file *f, const char __user *buf, size_t n, loff_t *pos)
+{
+	struct gk3_pen *p = f->private_data;
+	int ret;
+
+	mutex_lock(&p->lock);
+	ret = pen_hw_init(p, true);
+	p->init_ret = ret;
+	mutex_unlock(&p->lock);
+	if (!ret)
+		ret = pen_start(p);
+	return ret ? ret : n;
+}
+
+static const struct file_operations reinit_fops = {
+	.owner = THIS_MODULE,
+	.open = simple_open,
+	.write = reinit_write,
+};
+
+/* ---- /dev/gk3_pen: one struct pen_rec per read, newest changed frame ---- */
+
+struct pen_file {
+	struct gk3_pen *p;		/* referenced while the file is open */
+	u32 last;			/* uniq_seq this reader has seen */
+};
+
+static int pen_cdev_open(struct inode *inode, struct file *f)
+{
+	struct pen_file *pf;
+	struct gk3_pen *p;
+
+	pf = kzalloc_obj(*pf, GFP_KERNEL);
+	if (!pf)
+		return -ENOMEM;
+	mutex_lock(&gk3_pen_dev_lock);
+	p = gk3_pen_dev;
+	if (p)
+		kref_get(&p->ref);
+	mutex_unlock(&gk3_pen_dev_lock);
+	if (!p) {
+		kfree(pf);
+		return -ENODEV;
+	}
+	pf->p = p;
+	pf->last = READ_ONCE(p->uniq_seq);
+	f->private_data = pf;
+	return stream_open(inode, f);
+}
+
+static int pen_cdev_release(struct inode *inode, struct file *f)
+{
+	struct pen_file *pf = f->private_data;
+
+	pen_put(pf->p);
+	kfree(pf);
+	return 0;
+}
+
+static ssize_t pen_cdev_read(struct file *f, char __user *buf, size_t n, loff_t *pos)
+{
+	struct pen_file *pf = f->private_data;
+	struct gk3_pen *p = pf->p;
+	struct pen_rec rec;
+	int ret;
+
+	if (READ_ONCE(p->gone))
+		return -ENODEV;
+	if (n < sizeof(rec))
+		return -EINVAL;
+	if (READ_ONCE(p->uniq_seq) == pf->last) {
+		if (f->f_flags & O_NONBLOCK)
+			return -EAGAIN;
+		ret = wait_event_interruptible(p->wq,
+					       READ_ONCE(p->uniq_seq) != pf->last ||
+					       READ_ONCE(p->gone));
+		if (ret)
+			return ret;
+		if (READ_ONCE(p->gone))
+			return -ENODEV;
+	}
+	mutex_lock(&p->lock);
+	rec = p->uniq;
+	pf->last = p->uniq_seq;
+	mutex_unlock(&p->lock);
+	if (copy_to_user(buf, &rec, sizeof(rec)))
+		return -EFAULT;
+	return sizeof(rec);
+}
+
+/* ---- pen battery (see 8. above) ---- */
+
+static int pen_bat_capacity = -1;	/* percent; -1 = not reported yet */
+static int pen_bat_charging = -1;	/* 0/1; -1 = not reported yet */
+static struct power_supply *pen_bat;
+
+static const enum power_supply_property pen_bat_props[] = {
+	POWER_SUPPLY_PROP_STATUS,
+	POWER_SUPPLY_PROP_PRESENT,
+	POWER_SUPPLY_PROP_CAPACITY,
+	POWER_SUPPLY_PROP_SCOPE,
+	POWER_SUPPLY_PROP_MODEL_NAME,
+	POWER_SUPPLY_PROP_MANUFACTURER,
+};
+
+static int pen_bat_get(struct power_supply *psy, enum power_supply_property psp,
+		       union power_supply_propval *val)
+{
+	int cap = READ_ONCE(pen_bat_capacity), chg = READ_ONCE(pen_bat_charging);
+
+	switch (psp) {
+	case POWER_SUPPLY_PROP_STATUS:
+		if (cap < 0 || chg < 0)
+			val->intval = POWER_SUPPLY_STATUS_UNKNOWN;
+		else if (!chg)
+			val->intval = POWER_SUPPLY_STATUS_DISCHARGING;
+		else
+			val->intval = cap >= 100 ? POWER_SUPPLY_STATUS_FULL :
+				      POWER_SUPPLY_STATUS_CHARGING;
+		break;
+	case POWER_SUPPLY_PROP_PRESENT:
+		val->intval = cap >= 0;
+		break;
+	case POWER_SUPPLY_PROP_CAPACITY:
+		if (cap < 0)
+			return -ENODATA;
+		val->intval = cap;
+		break;
+	case POWER_SUPPLY_PROP_SCOPE:
+		val->intval = POWER_SUPPLY_SCOPE_DEVICE;
+		break;
+	case POWER_SUPPLY_PROP_MODEL_NAME:
+		val->strval = "M-Pencil";
+		break;
+	case POWER_SUPPLY_PROP_MANUFACTURER:
+		val->strval = "HUAWEI";
+		break;
+	default:
+		return -EINVAL;
+	}
+	return 0;
+}
+
+static const struct power_supply_desc pen_bat_desc = {
+	.name = "m-pencil",
+	.type = POWER_SUPPLY_TYPE_BATTERY,
+	.properties = pen_bat_props,
+	.num_properties = ARRAY_SIZE(pen_bat_props),
+	.get_property = pen_bat_get,
+};
+
+/*
+ * Nothing about the pen's battery needs to wake the system, and a wakeup
+ * source would put a wakeup/ directory under the supply that inherits its
+ * SELinux label, which system_suspend is then denied reading.
+ */
+static const struct power_supply_config pen_bat_cfg = {
+	.no_wakeup_source = true,
+};
+
+/* 'B', level (0-100), charging (0/1); 0xff leaves that field as it is */
+static void pen_bat_set(const u8 *m)
+{
+	int cap = m[1] <= 100 ? m[1] : READ_ONCE(pen_bat_capacity);
+	int chg = m[2] <= 1 ? m[2] : READ_ONCE(pen_bat_charging);
+
+	if (cap == READ_ONCE(pen_bat_capacity) && chg == READ_ONCE(pen_bat_charging))
+		return;
+	WRITE_ONCE(pen_bat_capacity, cap);
+	WRITE_ONCE(pen_bat_charging, chg);
+	if (pen_bat)
+		power_supply_changed(pen_bat);
+}
+
+/*
+ * A battery message (above), or any other write: the pen is in use (its
+ * controller is reporting), so stay awake.
+ */
+static ssize_t pen_cdev_write(struct file *f, const char __user *buf, size_t n, loff_t *pos)
+{
+	struct pen_file *pf = f->private_data;
+	struct gk3_pen *p = pf->p;
+	u8 m[3];
+
+	if (n == sizeof(m)) {
+		if (copy_from_user(m, buf, sizeof(m)))
+			return -EFAULT;
+		if (m[0] == 'B') {
+			pen_bat_set(m);
+			return n;
+		}
+	}
+	mutex_lock(&p->lock);
+	/* after remove the interrupt is gone; don't touch the hardware */
+	if (p->gone) {
+		mutex_unlock(&p->lock);
+		return -ENODEV;
+	}
+	p->hints++;
+	p->pen_seen = jiffies;
+	if (p->idle) {
+		p->hint_wakes++;
+		pen_set_idle(p, false);
+	}
+	mutex_unlock(&p->lock);
+	return n;
+}
+
+static __poll_t pen_cdev_poll(struct file *f, poll_table *wait)
+{
+	struct pen_file *pf = f->private_data;
+	struct gk3_pen *p = pf->p;
+
+	poll_wait(f, &p->wq, wait);
+	if (READ_ONCE(p->gone))
+		return EPOLLERR | EPOLLHUP;
+	return READ_ONCE(p->uniq_seq) != pf->last ? EPOLLIN | EPOLLRDNORM : 0;
+}
+
+static const struct file_operations pen_cdev_fops = {
+	.owner = THIS_MODULE,
+	.open = pen_cdev_open,
+	.release = pen_cdev_release,
+	.read = pen_cdev_read,
+	.write = pen_cdev_write,
+	.poll = pen_cdev_poll,
+};
+
+/* ---- driver ---- */
+
+static int gk3_pen_probe(struct spi_device *spi)
+{
+	struct device *dev = &spi->dev;
+	struct gk3_pen *p;
+	int ret;
+
+	/* not devm: open files of /dev/gk3_pen keep it beyond the unbind */
+	p = kzalloc_obj(*p, GFP_KERNEL);
+	if (!p)
+		return -ENOMEM;
+	kref_init(&p->ref);
+	ret = devm_add_action_or_reset(dev, pen_put, p);
+	if (ret)
+		return ret;
+	p->xfer = devm_kzalloc(dev, HDR_LEN + FRAME_LEN, GFP_KERNEL);
+	p->ring = devm_kcalloc(dev, RING_LEN, sizeof(*p->ring), GFP_KERNEL);
+	if (!p->xfer || !p->ring)
+		return -ENOMEM;
+
+	/*
+	 * The panel's follower callbacks stop the watchdog and the idle
+	 * polling while the screen is off.  If the panel has not probed yet the
+	 * follower cannot be added and both would keep running for good, so
+	 * defer until it has, before anything is started.  Other lookup
+	 * failures end in the always-on watchdog below.
+	 */
+	if (drm_is_panel_follower(dev)) {
+		struct device_node *np = of_parse_phandle(dev->of_node, "panel", 0);
+		struct drm_panel *panel = of_drm_find_panel(np);
+
+		of_node_put(np);
+		if (panel == ERR_PTR(-EPROBE_DEFER))
+			return dev_err_probe(dev, -EPROBE_DEFER, "waiting for the panel\n");
+	}
+
+	p->spi = spi;
+	p->tx1_peak_max = S16_MIN;
+	mutex_init(&p->lock);
+	INIT_DELAYED_WORK(&p->idle_poll, pen_idle_poll_fn);
+	init_waitqueue_head(&p->wq);
+	spi_set_drvdata(spi, p);
+
+	spi->mode = spi_mode & 3;
+	spi->bits_per_word = 8;
+	spi->max_speed_hz = speed_hz;
+	ret = spi_setup(spi);
+	if (ret)
+		return dev_err_probe(dev, ret, "spi_setup\n");
+
+	p->dbg = debugfs_create_dir("gk3_pen", NULL);
+	debugfs_create_file("stats", 0400, p->dbg, p, &stats_fops);
+	debugfs_create_file("ring", 0400, p->dbg, p, &ring_fops);
+	debugfs_create_file("reinit", 0200, p->dbg, p, &reinit_fops);
+
+	mutex_lock(&p->lock);
+	p->init_ret = pen_hw_init(p, true);
+	mutex_unlock(&p->lock);
+	dev_info(dev, "slave init %d (mode %d, %d Hz, irq %d)\n",
+		 p->init_ret, spi->mode & 3, spi->max_speed_hz, spi->irq);
+
+	mutex_lock(&gk3_pen_dev_lock);
+	gk3_pen_dev = p;
+	mutex_unlock(&gk3_pen_dev_lock);
+	p->misc.minor = MISC_DYNAMIC_MINOR;
+	p->misc.name = "gk3_pen";
+	p->misc.fops = &pen_cdev_fops;
+	p->misc.mode = 0600;
+	ret = misc_register(&p->misc);
+	if (ret)
+		dev_err(dev, "misc_register: %d\n", ret);
+	else
+		p->misc_ok = true;
+
+	/* Stay bound even if the bus check failed: debugfs reinit can retry. */
+	if (!p->init_ret) {
+		ret = pen_start(p);
+		if (ret)
+			dev_err(dev, "start: %d\n", ret);
+	}
+
+	/*
+	 * Follow the panel (the DT sets panel = <&panel>).  The enabled
+	 * callback runs right away if the screen is on, which starts the
+	 * watchdog.  Without a panel, run the watchdog unconditionally.
+	 */
+	INIT_DELAYED_WORK(&p->watchdog, pen_watchdog_fn);
+	p->follower.funcs = &pen_follower_funcs;
+	ret = drm_panel_add_follower(dev, &p->follower);
+	if (ret) {
+		dev_warn(dev, "no panel to follow (%d), watchdog always on\n", ret);
+		pen_panel_enabled(&p->follower);
+	} else {
+		p->follower_ok = true;
+	}
+	return 0;
+}
+
+static void gk3_pen_remove(struct spi_device *spi)
+{
+	struct gk3_pen *p = spi_get_drvdata(spi);
+
+	/* stop the panel from re-arming the watchdog, then stop the watchdog */
+	if (p->follower_ok)
+		drm_panel_remove_follower(&p->follower);
+	mutex_lock(&p->lock);
+	WRITE_ONCE(p->gone, true);
+	pen_set_idle(p, false);
+	mutex_unlock(&p->lock);
+	cancel_delayed_work_sync(&p->watchdog);
+	cancel_delayed_work_sync(&p->idle_poll);
+	wake_up_interruptible(&p->wq);
+	mutex_lock(&gk3_pen_dev_lock);
+	gk3_pen_dev = NULL;
+	mutex_unlock(&gk3_pen_dev_lock);
+	if (p->misc_ok)
+		misc_deregister(&p->misc);
+	if (p->poller)
+		kthread_stop(p->poller);
+	if (use_irq && p->running)
+		devm_free_irq(&spi->dev, spi->irq, p);
+	debugfs_remove_recursive(p->dbg);
+}
+
+static const struct of_device_id gk3_pen_of_match[] = {
+	{ .compatible = "himax,hx83121a-pen-slave" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, gk3_pen_of_match);
+
+static const struct spi_device_id gk3_pen_ids[] = {
+	{ "hx83121a-pen-slave" },
+	{ }
+};
+MODULE_DEVICE_TABLE(spi, gk3_pen_ids);
+
+static struct spi_driver gk3_pen_driver = {
+	.driver = {
+		.name = "himax-hx83121a-pen",
+		.of_match_table = gk3_pen_of_match,
+		/*
+		 * A manual unbind would free the device state while gk3pend
+		 * still has /dev/gk3_pen open.
+		 */
+		.suppress_bind_attrs = true,
+	},
+	.id_table = gk3_pen_ids,
+	.probe = gk3_pen_probe,
+	.remove = gk3_pen_remove,
+};
+
+static int __init gk3_pen_init(void)
+{
+	int ret;
+
+	/* not fatal: the pen works without */
+	pen_bat = power_supply_register(NULL, &pen_bat_desc, &pen_bat_cfg);
+	if (IS_ERR(pen_bat)) {
+		pr_warn("battery not registered: %ld\n", PTR_ERR(pen_bat));
+		pen_bat = NULL;
+	}
+
+	ret = spi_register_driver(&gk3_pen_driver);
+	if (ret && pen_bat)
+		power_supply_unregister(pen_bat);
+	return ret;
+}
+
+static void __exit gk3_pen_exit(void)
+{
+	spi_unregister_driver(&gk3_pen_driver);
+	if (pen_bat)
+		power_supply_unregister(pen_bat);
+}
+
+module_init(gk3_pen_init);
+module_exit(gk3_pen_exit);
+
+MODULE_DESCRIPTION("Himax HX83121A cascade slave (active pen) driver for HUAWEI MateBook E Go");
+MODULE_LICENSE("GPL");
diff --git a/drivers/input/touchscreen/hx-algo.c b/drivers/input/touchscreen/hx-algo.c
new file mode 100644
index 0000000..9e58aef
--- /dev/null
+++ b/drivers/input/touchscreen/hx-algo.c
@@ -0,0 +1,2587 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Himax HX83121A touch algorithm implementation.
+ *
+ * This file contains the pure signal-processing pipeline:
+ *   Phase 1: preprocessing  (baseline subtraction, CMF, IIR)
+ *   Phase 2: touch solving  (macro-zone BFS, palm rejection, peak detection)
+ *   Phase 3: tracking       (greedy distance-matching)
+ *
+ * No SPI, no IRQ, no input_dev — all driver glue lives in himax-spi-core.c.
+ */
+
+#include <linux/kernel.h>
+#include <linux/limits.h>
+#include <linux/math64.h>
+#include <linux/string.h>
+
+#include "hx-algo.h"
+
+/* Raw baseline value output by the firmware when no touch is present. */
+#define HX_BASELINE  0x7ffe
+
+/*
+ * Default tracking constants — exposed through hx_algo fields so they can
+ * be overridden at runtime via sysfs without reloading the module.
+ *
+ * A contact within sqrt(HIMAX_TRACK_MATCH_DIST2) of a track's predicted
+ * position (1 unit = 0.104 mm) is taken as the same finger.  A finger stays
+ * within about 6 mm of the prediction from one frame to the next; a wider
+ * radius lets a finger landing near one that has just lifted (whose track
+ * lingers for HIMAX_TRACK_LOST_FRAMES) take over that track, and the tap is
+ * lost.
+ */
+#define HIMAX_TRACK_MATCH_DIST2   (115 * 115)
+#define HIMAX_TRACK_LOST_FRAMES   3
+#define HIMAX_NEW_TOUCH_DEBOUNCE  2
+
+/* ======================================================================== */
+/* Initialisation                                                            */
+/* ======================================================================== */
+
+void hx_algo_init_defaults(struct hx_algo *algo)
+{
+	algo->baseline_mode      = 2;    /* adaptive, CMF before the gate */
+	algo->baseline_fw_finger = true;
+	algo->baseline_gate      = 305;
+	algo->cmf_enabled        = true;
+	algo->cmf_mode           = 3;    /* rows and columns            */
+	algo->cmf_exclusion      = 250;
+	algo->cmf_max_correction = 500;
+	algo->iir_enabled        = false;
+	algo->iir_decay_weight   = 200;
+	algo->iir_decay_step     = 80;
+	algo->iir_noise_floor    = 5;
+	algo->iir_gate_floor     = 200;
+	algo->iir_gate_ratio_q8  = 26;
+	algo->macro_threshold    = 280;
+	algo->peak_threshold     = 280;
+	algo->peak_edge_threshold = 300;
+	algo->peak_drift_limit   = 1000;
+	algo->peak_merge_radius  = 2;
+	algo->min_area           = 2;
+	algo->iso_nbr_ratio_q8   = 8;    /* legacy (z >> 5) behaviour  */
+	algo->edge_min_area      = 1;    /* legacy: border cell exempt */
+	algo->palm_enabled       = true;
+	algo->palm_zone_scan     = false;  /* legacy: palm zones yield no peaks */
+	algo->palm_contact_area  = 0;      /* legacy: no per-contact palm test  */
+	algo->palm_area_threshold    = 50;
+	algo->palm_signal_threshold  = 80000;
+	algo->palm_density_low       = 400;
+	algo->hand_enabled       = true;
+	algo->hand_margin        = 2;   /* ~9 mm around a palm or hand blob  */
+	algo->hand_hold_frames   = 36;  /* ~300 ms at 120 Hz                 */
+	algo->hand_land_frames   = 12;  /* ~100 ms either side of a landing  */
+	algo->hand_land_dist     = 25;  /* ~11 cm: a flat hand's fingertips  */
+	hx_hand_reset(algo);
+	algo->pressure_enabled   = false;
+	algo->edge_comp_enabled = true;
+	algo->edge_boost_pct   = 50;   /* 50% signal boost on border pixels  */
+	algo->edge_push_q8     = 128;  /* push up to 0.5 grid cells outward  */
+	algo->edge_blend_q8    = 512;  /* blend over 2 grid cells from edge  */
+	algo->edge_comp_mode   = 0;
+	algo->edge_peak_mode   = 0;
+	algo->zone_split       = true;
+	algo->track_dist2_max   = HIMAX_TRACK_MATCH_DIST2;
+	algo->track_lost_frames = HIMAX_TRACK_LOST_FRAMES;
+	algo->track_fw_lost_frames = 1;   /* a lone wrong flag must not cut a touch */
+	algo->debounce_base     = HIMAX_NEW_TOUCH_DEBOUNCE;
+	algo->ghost_row_filter  = false;
+	algo->debounce_strong   = 3000;
+	algo->track_min_signal  = 1500;
+	algo->track_smoothing   = false;  /* the position filter replaces it */
+	algo->track_active_guard   = true;
+	algo->track_start_debounce = 2;
+	algo->track_jump_dist2     = 0;  /* disabled by default */
+	algo->track_tap_radius     = 20;   /* ~2 mm */
+	algo->track_tap_speed      = 15;   /* ~1.5 mm in one frame */
+	algo->track_tap_hard       = 22;   /* ~2.3 mm */
+	algo->track_tap_fall       = 50;
+	algo->track_tap_snap       = true;
+	algo->track_filter_mincutoff = 1000;  /* 1 Hz at rest */
+	algo->track_filter_beta      = 30;
+	algo->track_filter_dcutoff   = 30000;
+}
+
+/* ======================================================================== */
+/* Phase 1A — baseline subtraction                                          */
+/* ======================================================================== */
+
+/*
+ * Adaptive baseline (baseline_mode 1), after the EGoTouchRev service's
+ * BaselineTracker.
+ *
+ * Each cell tracks its own baseline in 1/256 units.  While the panel has a
+ * finger on it, the median of (raw - baseline) over the whole panel is taken
+ * as common-mode and removed; a cell that is then more than baseline_gate
+ * above its baseline passes through with its baseline frozen, and every
+ * other cell reads 0 while its baseline follows it -- slowly when it rises
+ * (temperature), faster when it falls (a lifting finger), and fast for the
+ * first frames of a touch or while nothing passes the gate (recovery), so a
+ * weak contact is absorbed rather than reported.  A cell that passed the
+ * gate is held for HX_BASE_HOLD frames after it drops below it: a sharp dip
+ * then passes through instead of being absorbed.  Without a finger every
+ * cell reads 0 and the baseline follows quickly.
+ *
+ * The firmware says whether it sees a finger; baseline_fw_finger decides
+ * whether to trust it.  Without it every frame is treated as touched, so
+ * there is no finger-off transition to start recovery from: recovery runs
+ * whenever nothing passed the gate the frame before, which also stands in
+ * for the fast no-finger tracking.  A cell that stays above the gate
+ * without a finger (a step in the panel's drift) is then never released;
+ * with the flag it is, the next time the firmware sees no finger.
+ *
+ * The baseline starts from the first frame rather than the service's
+ * fixed 0x7fee: without the flag there is no finger-free phase in which a
+ * cell whose idle level lies more than the gate above that could settle,
+ * and it would read as a touch from the start.  A finger on the panel at
+ * that moment is absorbed instead and reads negative once lifted.
+ *
+ * baseline_mode 2 runs the CMF on every cell before the gate instead of on
+ * the gated frame after it.  Coupled through a PC's USB ground, the panel
+ * carries row and column offsets that lift cells next to a finger over the
+ * gate; there the gated frame has nothing left to estimate them from.
+ */
+#define HX_BASE_DEADBAND	90	/* |delta| up to this is noise       */
+#define HX_BASE_NEG_DEADBAND	13	/* a held cell this far down passes  */
+#define HX_BASE_HOLD		60	/* frames                            */
+#define HX_BASE_RECOVERY	30	/* frames                            */
+
+static void hx_apply_cmf(struct hx_algo *algo);
+
+static void hx_base_update(struct hx_algo *algo, int i, s32 delta,
+			   int shift, s32 max_step)
+{
+	s32 step = (delta * 256) >> shift;
+
+	if (max_step > 0)
+		step = clamp_t(s32, step, -max_step * 256, max_step * 256);
+	algo->base_q8[i] = clamp_t(s32, algo->base_q8[i] + step, 0, 0xffff << 8);
+}
+
+/* The median of raw - baseline over the panel, clamped to the histogram. */
+static s32 hx_base_median(struct hx_algo *algo, const u16 *raw)
+{
+	int i, half = HX_BASE_HIST / 2;
+	u32 seen = 0;
+
+	memset(algo->base_hist, 0, sizeof(algo->base_hist));
+	for (i = 0; i < HX_PIXELS; i++) {
+		s32 d = (s32)le16_to_cpup(raw + i) - (algo->base_q8[i] >> 8);
+
+		algo->base_hist[clamp_t(s32, d + half, 0, HX_BASE_HIST - 1)]++;
+	}
+	for (i = 0; i < HX_BASE_HIST; i++) {
+		seen += algo->base_hist[i];
+		if (seen > HX_PIXELS / 2)
+			break;
+	}
+	return i - half;
+}
+
+static void hx_track_baseline(struct hx_algo *algo, const u16 *raw, u8 mode)
+{
+	bool finger = !algo->baseline_fw_finger || algo->fw_finger;
+	s16 *out = &algo->frame[0][0];
+	bool recovery = false, freeze = false;
+	s32 common;
+	int i;
+
+	if (!algo->base_init || algo->base_mode != mode) {
+		for (i = 0; i < HX_PIXELS; i++)
+			algo->base_q8[i] = (s32)le16_to_cpup(raw + i) << 8;
+		memset(algo->base_hold, 0, sizeof(algo->base_hold));
+		algo->base_prev_finger = false;
+		algo->base_had_freeze = false;
+		algo->base_recovery = 0;
+		algo->base_mode = mode;
+		algo->base_init = true;
+	}
+
+	if (!finger) {
+		for (i = 0; i < HX_PIXELS; i++) {
+			s32 delta = (s32)le16_to_cpup(raw + i) - (algo->base_q8[i] >> 8);
+
+			algo->base_hold[i] = 0;
+			if (abs(delta) > HX_BASE_DEADBAND)
+				hx_base_update(algo, i, delta, 3, 512);
+			else if (delta)
+				hx_base_update(algo, i, delta, 6, 1);
+			out[i] = 0;
+		}
+		algo->base_had_freeze = false;
+		algo->base_recovery = 0;
+		algo->base_prev_finger = false;
+		return;
+	}
+
+	/*
+	 * Recovery: a touch has just begun, or nothing passed the gate for
+	 * fewer than HX_BASE_RECOVERY frames into it.  Without the flag:
+	 * whenever nothing passed the gate last frame.
+	 */
+	if (!algo->baseline_fw_finger) {
+		recovery = !algo->base_had_freeze;
+	} else if (!algo->base_prev_finger) {
+		recovery = true;
+		algo->base_recovery = 0;
+	} else if (!algo->base_had_freeze) {
+		if (algo->base_recovery < U8_MAX)
+			algo->base_recovery++;
+		recovery = algo->base_recovery < HX_BASE_RECOVERY;
+	}
+
+	common = hx_base_median(algo, raw);
+	if (mode == 2) {
+		for (i = 0; i < HX_PIXELS; i++)
+			out[i] = clamp_t(s32, (s32)le16_to_cpup(raw + i) -
+					 (algo->base_q8[i] >> 8) - common,
+					 SHRT_MIN, SHRT_MAX);
+		out[0] = 0;
+		if (algo->cmf_enabled)
+			hx_apply_cmf(algo);
+	}
+	/* Cell 0 is not a real cell on this panel; it stays 0. */
+	out[0] = 0;
+	for (i = 1; i < HX_PIXELS; i++) {
+		s32 delta = (s32)le16_to_cpup(raw + i) - (algo->base_q8[i] >> 8);
+		s32 local = mode == 2 ? out[i] : delta - common;
+
+		if (local > algo->baseline_gate) {
+			/* Frozen: only follow the panel-wide shift. */
+			freeze = true;
+			algo->base_hold[i] = HX_BASE_HOLD;
+			if (common)
+				hx_base_update(algo, i, common, 3, 512);
+			out[i] = clamp_t(s32, local, SHRT_MIN, SHRT_MAX);
+			continue;
+		}
+		if (algo->base_hold[i]) {
+			algo->base_hold[i]--;
+			if (local < -HX_BASE_NEG_DEADBAND) {
+				out[i] = clamp_t(s32, local, SHRT_MIN, SHRT_MAX);
+				continue;
+			}
+		}
+		if (recovery)
+			hx_base_update(algo, i, delta, 2, 256);
+		else if (abs(delta) > HX_BASE_DEADBAND)
+			hx_base_update(algo, i, delta, delta > 0 ? 7 : 5, 20);
+		else if (delta)
+			hx_base_update(algo, i, delta, 6, 1);
+		out[i] = 0;
+	}
+	algo->base_had_freeze = freeze;
+	algo->base_prev_finger = true;
+}
+
+static void hx_prepare_frame_baseline(struct hx_algo *algo, const u16 *raw)
+{
+	u8 mode = READ_ONCE(algo->baseline_mode);
+	int r, c;
+
+	for (r = 0; r < HX_ROWS; r++) {
+		for (c = 0; c < HX_COLS; c++) {
+			int idx = r * HX_COLS + c;
+			s32 sample = (s32)le16_to_cpup(raw + idx) - HX_BASELINE;
+
+			algo->raw_frame[r][c] = clamp_t(s32, sample, SHRT_MIN, SHRT_MAX);
+		}
+	}
+
+	/* pixel [0][0] is always invalid on this panel layout */
+	algo->raw_frame[0][0] = 0;
+
+	/*
+	 * raw_frame[] keeps the frame against the fixed baseline for the
+	 * diagnostic dump in either mode (a recording of it replays through
+	 * both); everything after this point (CMF, edge boost, IIR) rewrites
+	 * frame[] in place.
+	 */
+	if (mode) {
+		hx_track_baseline(algo, raw, mode);
+	} else {
+		memcpy(algo->frame, algo->raw_frame, sizeof(algo->frame));
+		algo->base_mode = 0;
+	}
+}
+
+/* ======================================================================== */
+/* Phase 1A½ — edge signal boost                                            */
+/*                                                                           */
+/* Compensate reduced capacitive sensitivity at sensor borders by scaling   */
+/* border pixels upward.  Row 0/last and col 0/last get the full boost;    */
+/* row 1/last-1 and col 1/last-1 get half.  Corner pixels (on two borders) */
+/* are boosted once from each axis (multiplicative).                         */
+/* ======================================================================== */
+
+static void hx_edge_boost(struct hx_algo *algo)
+{
+	int r, c;
+	s32 pct = algo->edge_boost_pct;
+	s32 half_pct = pct / 2;
+
+	if (!algo->edge_comp_enabled || pct <= 0)
+		return;
+
+	/* Boost border rows: row 0 and row HX_ROWS-1 (full), row 1 and HX_ROWS-2 (half) */
+	for (c = 0; c < HX_COLS; c++) {
+		s32 v;
+
+		/* Top edge */
+		v = algo->frame[0][c];
+		if (v > 0)
+			algo->frame[0][c] = clamp_t(s32, v + v * pct / 100, 0, SHRT_MAX);
+		v = algo->frame[1][c];
+		if (v > 0)
+			algo->frame[1][c] = clamp_t(s32, v + v * half_pct / 100, 0, SHRT_MAX);
+
+		/* Bottom edge */
+		v = algo->frame[HX_ROWS - 1][c];
+		if (v > 0)
+			algo->frame[HX_ROWS - 1][c] = clamp_t(s32, v + v * pct / 100, 0, SHRT_MAX);
+		v = algo->frame[HX_ROWS - 2][c];
+		if (v > 0)
+			algo->frame[HX_ROWS - 2][c] = clamp_t(s32, v + v * half_pct / 100, 0, SHRT_MAX);
+	}
+
+	/* Boost border columns: col 0 and col HX_COLS-1 (full), col 1 and HX_COLS-2 (half) */
+	for (r = 0; r < HX_ROWS; r++) {
+		s32 v;
+
+		/* Left edge */
+		v = algo->frame[r][0];
+		if (v > 0)
+			algo->frame[r][0] = clamp_t(s32, v + v * pct / 100, 0, SHRT_MAX);
+		v = algo->frame[r][1];
+		if (v > 0)
+			algo->frame[r][1] = clamp_t(s32, v + v * half_pct / 100, 0, SHRT_MAX);
+
+		/* Right edge */
+		v = algo->frame[r][HX_COLS - 1];
+		if (v > 0)
+			algo->frame[r][HX_COLS - 1] = clamp_t(s32, v + v * pct / 100, 0, SHRT_MAX);
+		v = algo->frame[r][HX_COLS - 2];
+		if (v > 0)
+			algo->frame[r][HX_COLS - 2] = clamp_t(s32, v + v * half_pct / 100, 0, SHRT_MAX);
+	}
+}
+
+/* ======================================================================== */
+/* Phase 1B — CMF (Common Mode Filter)                                      */
+/*                                                                           */
+/* Removes charger-induced common-mode noise by subtracting per-row and     */
+/* per-column offsets computed from "quiet" pixels (|val| < exclusion).     */
+/* DualDim mode: rows first, then columns.                                   */
+/* ======================================================================== */
+
+static void hx_apply_cmf(struct hx_algo *algo)
+{
+	int r, c;
+
+	/* Row pass */
+	for (r = 0; r < HX_ROWS && (algo->cmf_mode & 1); r++) {
+		s32 sum = 0, count = 0, offset;
+
+		for (c = 0; c < HX_COLS; c++) {
+			s16 v = algo->frame[r][c];
+
+			if (abs((int)v) < algo->cmf_exclusion) {
+				sum += v;
+				count++;
+			}
+		}
+		if (!count)
+			continue;
+
+		offset = clamp_t(s32, sum / count,
+				 -algo->cmf_max_correction,
+				  algo->cmf_max_correction);
+		for (c = 0; c < HX_COLS; c++) {
+			s32 corrected = (s32)algo->frame[r][c] - offset;
+
+			algo->frame[r][c] = clamp_t(s32, corrected, SHRT_MIN, SHRT_MAX);
+		}
+	}
+
+	/* Column pass */
+	for (c = 0; c < HX_COLS && (algo->cmf_mode & 2); c++) {
+		s32 sum = 0, count = 0, offset;
+
+		for (r = 0; r < HX_ROWS; r++) {
+			s16 v = algo->frame[r][c];
+
+			if (abs((int)v) < algo->cmf_exclusion) {
+				sum += v;
+				count++;
+			}
+		}
+		if (!count)
+			continue;
+
+		offset = clamp_t(s32, sum / count,
+				 -algo->cmf_max_correction,
+				  algo->cmf_max_correction);
+		for (r = 0; r < HX_ROWS; r++) {
+			s32 corrected = (s32)algo->frame[r][c] - offset;
+
+			algo->frame[r][c] = clamp_t(s32, corrected, SHRT_MIN, SHRT_MAX);
+		}
+	}
+}
+
+/* ======================================================================== */
+/* Phase 1C — GridIIR temporal filter                                       */
+/*                                                                           */
+/* Per-pixel exponential decay for noise suppression.  Pixels above a       */
+/* dynamic threshold (proportional to the frame maximum) bypass the filter  */
+/* so real touch signals are never attenuated.                               */
+/* ======================================================================== */
+
+static void hx_apply_iir(struct hx_algo *algo)
+{
+	int r, c;
+	s32 frame_max = 0;
+	s32 dyn_threshold;
+	u16 decay_weight, decay_step;
+
+	if (!algo->iir_enabled) {
+		memcpy(algo->iir_history, algo->frame, sizeof(algo->frame));
+		algo->iir_initialized = true;
+		return;
+	}
+
+	if (!algo->iir_initialized) {
+		memcpy(algo->iir_history, algo->frame, sizeof(algo->frame));
+		algo->iir_initialized = true;
+		return;
+	}
+
+	for (r = 0; r < HX_ROWS; r++)
+		for (c = 0; c < HX_COLS; c++)
+			frame_max = max(frame_max, abs((int)algo->frame[r][c]));
+
+	dyn_threshold = max((frame_max * algo->iir_gate_ratio_q8) >> 8,
+			    (s32)algo->iir_gate_floor);
+	decay_weight  = min_t(u16, algo->iir_decay_weight, 256);
+	decay_step    = algo->iir_decay_step;
+
+	for (r = 0; r < HX_ROWS; r++) {
+		for (c = 0; c < HX_COLS; c++) {
+			s32 cur = algo->frame[r][c];
+			s32 output;
+
+			if (cur >= dyn_threshold) {
+				output = cur;
+			} else {
+				s32 hist  = algo->iir_history[r][c];
+				s32 mixed = decay_weight * cur +
+					    (256 - decay_weight) * hist;
+
+				output = mixed >> 8;
+				output = max(0, output - (s32)decay_step);
+				if (output < algo->iir_noise_floor)
+					output = 0;
+			}
+
+			algo->frame[r][c]       = clamp_t(s32, output, SHRT_MIN, SHRT_MAX);
+			algo->iir_history[r][c] = algo->frame[r][c];
+		}
+	}
+}
+
+/* ======================================================================== */
+/* Phase 1 entry point                                                       */
+/* ======================================================================== */
+
+void hx_preprocess_frame(struct hx_algo *algo, const u16 *raw)
+{
+	algo->stats.frames++;
+	hx_prepare_frame_baseline(algo, raw);
+
+	if (algo->cmf_enabled && algo->base_mode != 2)
+		hx_apply_cmf(algo);
+
+	hx_edge_boost(algo);
+
+	hx_apply_iir(algo);
+}
+
+/* ======================================================================== */
+/* Helpers                                                                   */
+/* ======================================================================== */
+
+/* Debug helper — kept for bring-up and signal-quality checks. */
+static void __maybe_unused dump_frame(const struct hx_algo *algo)
+{
+	if (!IS_ENABLED(CONFIG_DYNAMIC_DEBUG))
+		return;
+
+	char buf[1024];
+
+	pr_warn("Frame start\n");
+	for (int i = 0, offset; i < HX_PIXELS; i++) {
+		if (i % HX_COLS == 0) {
+			if (i)
+				pr_info("%s\n", buf);
+			offset = sprintf(buf, "%04x:", i);
+		}
+		offset += sprintf(buf + offset, " %04x",
+				  (u16)max_t(s16, 0,
+					     algo->frame[i / HX_COLS][i % HX_COLS]));
+	}
+}
+
+/*
+ * Clamp-to-zero accessor: returns 0 for out-of-bounds or negative values so
+ * neighbour lookups near the grid edge never need special-casing.
+ */
+static inline s16 hx_frame_at(const struct hx_algo *algo, int r, int c)
+{
+	s16 val;
+
+	if (r < 0 || r >= HX_ROWS || c < 0 || c >= HX_COLS)
+		return 0;
+	val = algo->frame[r][c];
+	return val > 0 ? val : 0;
+}
+
+/* ======================================================================== */
+/* Phase 2A — macro-zone detection (8-connected BFS)                        */
+/* ======================================================================== */
+
+void hx_detect_macro_zones(struct hx_algo *algo)
+{
+	static const int dr[] = {-1, -1, -1, 0, 0, 1, 1, 1};
+	static const int dc[] = {-1,  0,  1, -1, 1, -1, 0, 1};
+	u16 head, tail;
+	int r, c, d;
+	u8 next_id = 0;
+
+	memset(algo->visited, 0, sizeof(algo->visited));
+	memset(algo->zone_of, 0, sizeof(algo->zone_of));
+	algo->zone_count = 0;
+
+	for (r = 0; r < HX_ROWS; r++) {
+		for (c = 0; c < HX_COLS; c++) {
+			int idx = r * HX_COLS + c;
+			struct hx_macro_zone *zone;
+			u8 weakest = 0;
+			bool full;
+
+			if (algo->visited[idx])
+				continue;
+			if (algo->frame[r][c] < algo->macro_threshold)
+				continue;
+
+			/*
+			 * Once the table is full, build into the spare slot and keep
+			 * the result only if it beats the weakest zone already held.
+			 *
+			 * The previous code returned from the function here, which
+			 * abandoned the rest of the grid: with enough small noise
+			 * zones ahead of it in scan order -- charger coupling being
+			 * the usual source -- every real contact further down the
+			 * panel was lost outright, and nothing recorded that it had
+			 * happened.  Noise blobs sit just over macro_threshold and
+			 * span a cell or two, so signal_sum separates them from a
+			 * fingertip by an order of magnitude and is a safe key.
+			 */
+			full = algo->zone_count >= HX_MAX_ZONES;
+			if (full) {
+				u8 k;
+
+				for (k = 1; k < HX_MAX_ZONES; k++)
+					if (algo->zones[k].signal_sum <
+					    algo->zones[weakest].signal_sum)
+						weakest = k;
+				zone = &algo->spare;
+			} else {
+				zone = &algo->zones[algo->zone_count];
+			}
+
+			zone->area       = 0;
+			zone->signal_sum = 0;
+			zone->is_palm    = false;
+			zone->palm_rule  = 0;
+			/*
+			 * Ids are unique within the frame, also across eviction;
+			 * past 255 zones the rest share id 0, i.e. "no zone".
+			 */
+			zone->id = next_id < U8_MAX ? ++next_id : 0;
+			zone->min_r = r;  zone->max_r = r;
+			zone->min_c = c;  zone->max_c = c;
+
+			/* Ring-buffer BFS using the pre-allocated queue. */
+			head = 0;
+			tail = 0;
+			algo->bfs_queue[tail++] = idx;
+			algo->visited[idx] = 1;
+
+			while (head != tail) {
+				int ci = algo->bfs_queue[head++];
+				int cr = ci / HX_COLS;
+				int cc = ci % HX_COLS;
+				s16 sig = algo->frame[cr][cc];
+
+				if (zone->area < HX_ZONE_PX_MAX)
+					zone->pixels[zone->area] = ci;
+				zone->area++;
+				algo->zone_of[ci] = zone->id;
+				if (sig > 0)
+					zone->signal_sum += sig;
+
+				if (cr < zone->min_r) zone->min_r = cr;
+				if (cr > zone->max_r) zone->max_r = cr;
+				if (cc < zone->min_c) zone->min_c = cc;
+				if (cc > zone->max_c) zone->max_c = cc;
+
+				for (d = 0; d < 8; d++) {
+					int nr = cr + dr[d];
+					int nc = cc + dc[d];
+					int ni;
+
+					if (nr < 0 || nr >= HX_ROWS ||
+					    nc < 0 || nc >= HX_COLS)
+						continue;
+					ni = nr * HX_COLS + nc;
+					if (algo->visited[ni])
+						continue;
+					if (algo->frame[nr][nc] < algo->macro_threshold)
+						continue;
+					algo->visited[ni] = 1;
+					algo->bfs_queue[tail++] = ni;
+				}
+			}
+
+			algo->stats.zones++;
+			if (!full) {
+				algo->zone_count++;
+			} else if (zone->signal_sum >
+				   algo->zones[weakest].signal_sum) {
+				algo->zones[weakest] = *zone;
+				algo->stats.zones_evicted++;
+			} else {
+				algo->stats.zones_overflow++;
+			}
+		}
+	}
+}
+
+/* ======================================================================== */
+/* Phase 2B — palm rejection                                                 */
+/*                                                                           */
+/* Four integer-only rules.  A matching zone is *marked*, not discarded.    */
+/*                                                                           */
+/* Marking rather than deleting matters because hx_detect_macro_zones()     */
+/* is 8-connected at macro_threshold: a fingertip touching down against     */
+/* the heel of the hand ends up in the same zone as the palm, and deleting  */
+/* the zone took the finger with it, with nothing left to show it had       */
+/* happened.  The zone now survives with is_palm set, so the decision is    */
+/* visible in the counters and reversible at runtime.                       */
+/* Rule 1: area >= palm_area_threshold                (large footprint)     */
+/* Rule 2: signal_sum >= palm_signal_threshold         (strong integrated)  */
+/* Rule 3: area >= 20 && density < palm_density_low   (spread low signal)  */
+/* Rule 4: area >= 10 && aspect-ratio >= 4:1           (elongated shape)   */
+/* ======================================================================== */
+
+void hx_reject_palms(struct hx_algo *algo)
+{
+	u8 i;
+
+	if (!algo->palm_enabled)
+		return;
+
+	for (i = 0; i < algo->zone_count; i++) {
+		struct hx_macro_zone *z = &algo->zones[i];
+		u16 bbox_w, bbox_h, max_side, min_side;
+		bool reject = false;
+		u8 rule = 0;
+
+		/* Rule 1 */
+		if (z->area >= algo->palm_area_threshold) {
+			reject = true;
+			rule = 1;
+			goto next;
+		}
+
+		/* Rule 2 */
+		if (z->signal_sum >= algo->palm_signal_threshold) {
+			reject = true;
+			rule = 2;
+			goto next;
+		}
+
+		/* Rule 3: density = signal_sum / area < palm_density_low
+		 *         Rewritten without division: signal_sum < low * area
+		 *
+		 * NOTE: inert unless palm_density_low > macro_threshold.  Every
+		 * pixel in a zone is >= macro_threshold by BFS construction, so
+		 * signal_sum >= macro_threshold * area always holds.  It was
+		 * inert at the old threshold of 800; at 280 it catches broad,
+		 * weak zones, which in recordings were all resting palms.
+		 */
+		if (z->area >= 20 &&
+		    z->signal_sum < (s32)algo->palm_density_low * z->area) {
+			reject = true;
+			rule = 3;
+			goto next;
+		}
+
+		/* Rule 4: aspect ratio — fixed-point: max*256 >= 4*min*256 */
+		bbox_w   = z->max_c - z->min_c + 1;
+		bbox_h   = z->max_r - z->min_r + 1;
+		max_side = max(bbox_w, bbox_h);
+		min_side = min(bbox_w, bbox_h);
+		if (z->area >= 10 && min_side > 0 &&
+		    (u32)max_side * 256 >= 1024u * min_side) {
+			reject = true;
+			rule = 4;
+		}
+
+next:
+		z->is_palm   = reject;
+		z->palm_rule = rule;
+		if (reject)
+			algo->stats.palm_rule[rule]++;
+	}
+}
+
+/* ======================================================================== */
+/* Phase 2B½ / 2C½ — hand map                                               */
+/*                                                                           */
+/* The palm rules above only ever catch the heel of the hand.  The rest of  */
+/* a resting hand reaches the panel as fingertip-sized islands -- curled    */
+/* fingers, knuckles, the fingers of a flat hand -- that no per-zone rule   */
+/* can tell from a finger, and the palm itself passes through fingertip     */
+/* size while it lands and while it lifts.  Each of those became a short    */
+/* contact, and a press followed by a lift is a tap.                        */
+/*                                                                           */
+/* hand_age[] remembers where the hand has been: 0 = hand this frame,       */
+/* n = n frames ago, U8_MAX = not within the last 255 frames.  Palm zones   */
+/* are written into it every frame (hx_hand_update), together with the      */
+/* zone of every peak that falls inside it (hx_hand_filter), so a blob      */
+/* that belongs to the hand keeps itself marked for as long as it stays     */
+/* down and for hand_hold_frames after.  A palm appearing after a quiet     */
+/* spell is a landing; peaks and young tracks near it within                */
+/* hand_land_frames belong to the same hand.                                */
+/*                                                                           */
+/* Nothing changes until a palm zone shows up, so finger-only use takes     */
+/* none of these paths.                                                     */
+/* ======================================================================== */
+
+static void hx_reset_track(struct hx_track *trk);
+
+void hx_hand_reset(struct hx_algo *algo)
+{
+	memset(algo->hand_age, U8_MAX, sizeof(algo->hand_age));
+	algo->palm_seen = false;
+}
+
+/*
+ * Zones are collected in mark_id[] and marked in one pass over the grid,
+ * so a frame with many hand blobs costs no more than one with a few.
+ * Id 0 ("no zone") is never set.
+ */
+static inline void hx_want_zone(struct hx_algo *algo, u8 id)
+{
+	if (id)
+		algo->mark_id[id] = 1;
+}
+
+static void hx_mark_wanted(struct hx_algo *algo)
+{
+	int i;
+
+	for (i = 0; i < HX_PIXELS; i++)
+		if (algo->mark_id[algo->zone_of[i]])
+			algo->hand_mark[i] = 1;
+	memset(algo->mark_id, 0, sizeof(algo->mark_id));
+}
+
+/* Mark the square of hand_margin cells around (r, c). */
+static void hx_mark_around(struct hx_algo *algo, int r, int c)
+{
+	int m = algo->hand_margin, dr, dc;
+
+	for (dr = -m; dr <= m; dr++)
+		for (dc = -m; dc <= m; dc++) {
+			int nr = r + dr, nc = c + dc;
+
+			if (nr >= 0 && nr < HX_ROWS && nc >= 0 && nc < HX_COLS)
+				algo->hand_mark[nr * HX_COLS + nc] = 1;
+		}
+}
+
+/* Grow hand_mark[] by hand_margin cells (square), write it to hand_age[]. */
+static void hx_hand_commit(struct hx_algo *algo)
+{
+	int m = algo->hand_margin, r, c, k;
+
+	/* separable max filter: rows into hand_tmp, then columns back */
+	for (r = 0; r < HX_ROWS; r++)
+		for (c = 0; c < HX_COLS; c++) {
+			u8 v = 0;
+
+			for (k = max(c - m, 0); k <= min(c + m, HX_COLS - 1) && !v; k++)
+				v = algo->hand_mark[r * HX_COLS + k];
+			algo->hand_tmp[r * HX_COLS + c] = v;
+		}
+	for (r = 0; r < HX_ROWS; r++)
+		for (c = 0; c < HX_COLS; c++) {
+			u8 v = 0;
+
+			for (k = max(r - m, 0); k <= min(r + m, HX_ROWS - 1) && !v; k++)
+				v = algo->hand_tmp[k * HX_COLS + c];
+			if (v)
+				algo->hand_age[r * HX_COLS + c] = 0;
+		}
+}
+
+/* Within hand_land_dist cells (Chebyshev) of a palm zone's bounding box. */
+static bool hx_near_palm(const struct hx_algo *algo, int r, int c)
+{
+	int d = algo->hand_land_dist;
+	u8 i;
+
+	for (i = 0; i < algo->zone_count; i++) {
+		const struct hx_macro_zone *z = &algo->zones[i];
+
+		if (z->is_palm &&
+		    r >= z->min_r - d && r <= z->max_r + d &&
+		    c >= z->min_c - d && c <= z->max_c + d)
+			return true;
+	}
+	return false;
+}
+
+/* Grid cell under a track; inverse of the mapping in hx_expand_and_resolve(). */
+static void hx_track_cell(const struct hx_track *trk, int *r, int *c)
+{
+	*c = clamp_t(int, (trk->x * 6) >> 8, 0, HX_COLS - 1);
+	*r = clamp_t(int, ((trk->y * 32) / 5) >> 8, 0, HX_ROWS - 1);
+}
+
+/*
+ * A finger that has been down for longer than a landing lasts is left to
+ * the "inside the hand now" test alone.  Without this, resting a palm
+ * while holding a finger, or dragging a finger across the spot a palm
+ * just left, would drop that finger's peaks, and its track would end in
+ * a plain lift.
+ */
+static bool hx_established(const struct hx_algo *algo, const struct hx_track *trk)
+{
+	return trk->active && !trk->palm && !trk->debounce &&
+	       trk->age > algo->hand_land_frames;
+}
+
+static bool hx_near_established(const struct hx_algo *algo, int r, int c)
+{
+	int i;
+
+	for (i = 0; i < HIMAX_MAX_TOUCH; i++) {
+		const struct hx_track *trk = &algo->tracks[i];
+		int tr, tc;
+
+		if (!hx_established(algo, trk))
+			continue;
+		hx_track_cell(trk, &tr, &tc);
+		if (abs(tr - r) <= 2 && abs(tc - c) <= 2)
+			return true;
+	}
+	return false;
+}
+
+void hx_hand_update(struct hx_algo *algo)
+{
+	bool palm_now = false;
+	u8 i;
+	int k;
+
+	algo->frame_seq++;
+	for (k = 0; k < HX_PIXELS; k++)
+		if (algo->hand_age[k] < U8_MAX)
+			algo->hand_age[k]++;
+
+	if (!algo->hand_enabled)
+		return;
+
+	memset(algo->hand_mark, 0, sizeof(algo->hand_mark));
+	for (i = 0; i < algo->zone_count; i++) {
+		if (!algo->zones[i].is_palm)
+			continue;
+		palm_now = true;
+		hx_want_zone(algo, algo->zones[i].id);
+	}
+	if (!palm_now)
+		return;
+
+	if (!algo->palm_seen ||
+	    algo->frame_seq - algo->palm_seen_seq > algo->hand_hold_frames) {
+		algo->palm_land_seq = algo->frame_seq;
+		algo->stats.hand_lands++;
+	}
+	algo->palm_seen = true;
+	algo->palm_seen_seq = algo->frame_seq;
+
+	/*
+	 * While a palm lands, every blob in its reach is the same hand -- the
+	 * fingers of a flat hand come down with it, often before the heel is
+	 * large enough to count as a palm, and later flicker around the peak
+	 * threshold.  Marking them now, peak or not, lets the hand map follow
+	 * them from then on.  A zone holding an established finger is left
+	 * alone.
+	 */
+	if (algo->frame_seq - algo->palm_land_seq <= algo->hand_land_frames) {
+		for (i = 0; i < algo->zone_count; i++) {
+			const struct hx_macro_zone *z = &algo->zones[i];
+			bool keep = false;
+			int j;
+
+			if (z->is_palm ||
+			    !hx_near_palm(algo, (z->min_r + z->max_r) / 2,
+					  (z->min_c + z->max_c) / 2))
+				continue;
+			for (j = 0; j < HIMAX_MAX_TOUCH && !keep; j++) {
+				int tr, tc;
+
+				if (!hx_established(algo, &algo->tracks[j]))
+					continue;
+				hx_track_cell(&algo->tracks[j], &tr, &tc);
+				keep = algo->zone_of[tr * HX_COLS + tc] == z->id;
+			}
+			if (!keep)
+				hx_want_zone(algo, z->id);
+		}
+	}
+	hx_mark_wanted(algo);
+	hx_hand_commit(algo);
+}
+
+void hx_hand_filter(struct hx_algo *algo)
+{
+	bool landing;
+	u8 dst = 0, i;
+
+	if (!algo->hand_enabled)
+		return;
+
+	landing = algo->palm_seen &&
+		  algo->frame_seq - algo->palm_land_seq <= algo->hand_land_frames &&
+		  algo->frame_seq == algo->palm_seen_seq;
+
+	/*
+	 * Peaks: inside the hand now, or -- unless an established finger is
+	 * right there -- inside the remembered hand or near a landing palm.
+	 */
+	memset(algo->hand_mark, 0, sizeof(algo->hand_mark));
+	for (i = 0; i < algo->peak_count; i++) {
+		struct hx_peak *p = &algo->peaks[i];
+		int idx = p->r * HX_COLS + p->c;
+		bool hand;
+
+		if (algo->hand_age[idx] == 0)
+			hand = true;
+		else if (hx_near_established(algo, p->r, p->c))
+			hand = false;
+		else
+			hand = algo->hand_age[idx] <= algo->hand_hold_frames ||
+			       (landing && hx_near_palm(algo, p->r, p->c));
+		if (!hand) {
+			algo->peaks[dst++] = *p;
+			continue;
+		}
+		algo->stats.hand_peaks++;
+		hx_want_zone(algo, p->zone_id);
+	}
+	algo->peak_count = dst;
+	hx_mark_wanted(algo);
+	hx_hand_commit(algo);
+
+	/*
+	 * Tracks: one that now sits in the hand is the contact whose blob just
+	 * grew into a palm or merged with one; a young one near a landing palm
+	 * touched down with it.  Reported tracks are cancelled, the rest are
+	 * dropped before anyone saw them.
+	 */
+	memset(algo->hand_mark, 0, sizeof(algo->hand_mark));
+	for (i = 0; i < HIMAX_MAX_TOUCH; i++) {
+		struct hx_track *trk = &algo->tracks[i];
+		bool land;
+		int r, c;
+
+		if (!trk->active || trk->palm)
+			continue;
+		hx_track_cell(trk, &r, &c);
+		if (landing && trk->age <= algo->hand_land_frames &&
+		    hx_near_palm(algo, r, c)) {
+			land = true;
+			/* keep its blob suppressed from the next frame on */
+			hx_mark_around(algo, r, c);
+		} else if (algo->hand_age[r * HX_COLS + c] == 0) {
+			land = false;
+		} else {
+			continue;
+		}
+
+		if (trk->debounce) {
+			hx_reset_track(trk);
+			continue;
+		}
+		trk->palm = HX_TRK_PALM_NEW;
+		if (land)
+			algo->stats.hand_cancel_land++;
+		else
+			algo->stats.hand_cancel_map++;
+	}
+	hx_hand_commit(algo);
+}
+
+/* ======================================================================== */
+/* Phase 2C — peak detection within surviving zones                         */
+/* ======================================================================== */
+
+/*
+ * Asymmetric local-maximum test.
+ *
+ * "Before" neighbours (up + left in scan order) must be strictly less;
+ * "after" neighbours (down + right) may be equal.  This breaks ties on
+ * flat ridges so exactly one peak is produced per finger plateau.
+ */
+static bool hx_is_asymmetric_peak(const struct hx_algo *algo, int r, int c)
+{
+	s16 v = algo->frame[r][c];
+	int dr, dc;
+
+	for (dr = -1; dr <= 1; dr++) {
+		for (dc = -1; dc <= 1; dc++) {
+			int nr, nc;
+			s16 nv;
+			bool after;
+
+			if (dr == 0 && dc == 0)
+				continue;
+			nr = r + dr;
+			nc = c + dc;
+			if (nr < 0 || nr >= HX_ROWS || nc < 0 || nc >= HX_COLS)
+				continue;
+			nv    = algo->frame[nr][nc];
+			after = (dr > 0) || (dr == 0 && dc > 0);
+			if (after) {
+				if (nv > v) return false;
+			} else {
+				if (nv >= v) return false;
+			}
+		}
+	}
+	return true;
+}
+
+/*
+ * Pressure-drift detector.
+ *
+ * A flat palm press produces a nearly-uniform row of elevated pixels with
+ * low cross-row gradient.  Returns true when the peak signal falls in the
+ * drift range [3/8, 3/4] of the limit and the row gradient is low while the
+ * row signal sum is high relative to the peak.  The limit is
+ * peak_drift_limit, or peak_threshold when that is 0 -- in which case the
+ * range lies below the threshold and the test never fires.
+ */
+static bool hx_detect_pressure_drift(const struct hx_algo *algo, int r, int c)
+{
+	s16 limit     = algo->peak_drift_limit ?: algo->peak_threshold;
+	s16 peak_sig  = algo->frame[r][c];
+	s16 limit3_4  = (limit * 3) >> 2;
+	s16 limit3_8  = (limit * 3) >> 3;
+	int grad_sum  = 0;
+	int row_sum   = 0;
+	int col;
+
+	if (peak_sig > limit3_4 || peak_sig < limit3_8)
+		return false;
+
+	for (col = 1; col < HX_COLS - 1; col++) {
+		int grad = abs((int)hx_frame_at(algo, r, col + 1) -
+			       (int)hx_frame_at(algo, r, col - 1));
+
+		if (grad > limit / 3)
+			return false;   /* sharp spike → not drift */
+		grad_sum += grad;
+		if (algo->frame[r][col] > 0)
+			row_sum += algo->frame[r][col];
+	}
+
+	return (row_sum >= peak_sig * 9 / 2) &&
+	       (peak_sig * 6 >= grad_sum);
+}
+
+/*
+ * Insert a peak into the fixed-size peak array.  When the array is full,
+ * replace the weakest existing entry if the new peak is stronger.
+ */
+static void hx_insert_peak(struct hx_algo *algo, const struct hx_peak *p)
+{
+	int k, weakest;
+
+	if (algo->peak_count < HX_MAX_PEAKS) {
+		algo->peaks[algo->peak_count++] = *p;
+		return;
+	}
+
+	weakest = 0;
+	for (k = 1; k < HX_MAX_PEAKS; k++) {
+		if (algo->peaks[k].z < algo->peaks[weakest].z)
+			weakest = k;
+	}
+	if (p->z > algo->peaks[weakest].z)
+		algo->peaks[weakest] = *p;
+}
+
+/*
+ * Highest cell strictly between two peaks along the line joining them;
+ * within peak_merge_radius there is at most one.
+ */
+static s16 hx_saddle(const struct hx_algo *algo, const struct hx_peak *a,
+		     const struct hx_peak *b)
+{
+	int dr = b->r - a->r, dc = b->c - a->c;
+	int steps = max(abs(dr), abs(dc));
+	s16 saddle = 0;
+	int k;
+
+	for (k = 1; k < steps; k++) {
+		int nr = a->r + DIV_ROUND_CLOSEST(dr * k, steps);
+		int nc = a->c + DIV_ROUND_CLOSEST(dc * k, steps);
+
+		if ((nr == a->r && nc == a->c) || (nr == b->r && nc == b->c))
+			continue;
+		saddle = max(saddle, hx_frame_at(algo, nr, nc));
+	}
+	return saddle;
+}
+
+/*
+ * Two peaks of one zone within peak_merge_radius cells, with no real dip
+ * between them (the cell between is within max(80, 8%) of the weaker one),
+ * are one flat contact: drop the weaker.  Without this a pad pressed flat
+ * shows two maxima and arrives as two pointers.
+ */
+static void hx_merge_close_peaks(struct hx_algo *algo)
+{
+	bool drop[HX_MAX_PEAKS] = { false };
+	int r = algo->peak_merge_radius;
+	u8 i, j, dst = 0;
+
+	if (!r || algo->peak_count < 2)
+		return;
+
+	for (i = 0; i < algo->peak_count; i++) {
+		const struct hx_peak *a = &algo->peaks[i];
+
+		if (drop[i])
+			continue;
+		for (j = i + 1; j < algo->peak_count; j++) {
+			const struct hx_peak *b = &algo->peaks[j];
+			u8 weak;
+			s16 need;
+
+			if (drop[j] || a->zone_id != b->zone_id)
+				continue;
+			if (max(abs(a->r - b->r), abs(a->c - b->c)) > r)
+				continue;
+			weak = a->z <= b->z ? i : j;
+			need = max_t(s16, 80, algo->peaks[weak].z * 8 / 100);
+			if (algo->peaks[weak].z - hx_saddle(algo, a, b) < need) {
+				drop[weak] = true;
+				if (weak == i)
+					break;
+			}
+		}
+	}
+
+	for (i = 0; i < algo->peak_count; i++) {
+		if (drop[i])
+			algo->stats.rej_merged++;
+		else
+			algo->peaks[dst++] = algo->peaks[i];
+	}
+	algo->peak_count = dst;
+}
+
+/* Peaks on the outer columns weaker than 5/8 of the strongest cell there. */
+static void hx_drop_weak_column_peaks(struct hx_algo *algo, int c)
+{
+	s16 max_sig = 0, cutoff;
+	u8 i, dst = 0;
+	int r;
+
+	for (r = 0; r < HX_ROWS; r++)
+		max_sig = max(max_sig, algo->frame[r][c]);
+	if (max_sig <= 0)
+		return;
+
+	cutoff = (max_sig >> 3) * 5;
+	for (i = 0; i < algo->peak_count; i++) {
+		if (algo->peaks[i].c == c && algo->peaks[i].z < cutoff)
+			algo->stats.rej_edgeweak++;
+		else
+			algo->peaks[dst++] = algo->peaks[i];
+	}
+	algo->peak_count = dst;
+}
+
+void hx_detect_peaks(struct hx_algo *algo)
+{
+	u8 zi;
+
+	algo->peak_count = 0;
+
+	/* --- Asymmetric local-max scan within each surviving zone --- */
+	for (zi = 0; zi < algo->zone_count; zi++) {
+		struct hx_macro_zone *zone = &algo->zones[zi];
+		u16 px_limit = min_t(u16, zone->area, HX_ZONE_PX_MAX);
+		u16 pi;
+
+		/*
+		 * A zone the palm rules flagged yields no peaks, which is what
+		 * deleting it used to achieve.  palm_zone_scan lifts that so a
+		 * fingertip merged into a palm blob can still be found; the
+		 * per-contact palm_contact_area test in hx_expand_and_resolve()
+		 * is then what separates the two.  Both default to the old
+		 * behaviour -- this wants a real hand on the panel to tune.
+		 */
+		if (zone->is_palm && !algo->palm_zone_scan)
+			continue;
+
+		for (pi = 0; pi < px_limit; pi++) {
+			int idx = zone->pixels[pi];
+			int r = idx / HX_COLS;
+			int c = idx % HX_COLS;
+			s16 v = algo->frame[r][c];
+			s16 thold = algo->peak_threshold;
+			struct hx_peak peak;
+			int dr, dc;
+			s32 nbr_sum = 0;
+
+			/* As in the service, it can only raise the threshold. */
+			if (c == 1 || c == HX_COLS - 2 || r == HX_ROWS - 1)
+				thold = max(thold, algo->peak_edge_threshold);
+			if (v < thold)
+				continue;
+			if (!hx_is_asymmetric_peak(algo, r, c))
+				continue;
+			if (hx_detect_pressure_drift(algo, r, c)) {
+				algo->stats.rej_drift++;
+				continue;
+			}
+
+			for (dr = -1; dr <= 1; dr++)
+				for (dc = -1; dc <= 1; dc++) {
+					if (dr == 0 && dc == 0)
+						continue;
+					nbr_sum += hx_frame_at(algo, r + dr, c + dc);
+				}
+
+			peak = (struct hx_peak){
+				.r         = r,
+				.c         = c,
+				.z         = v,
+				.nbr_sum   = nbr_sum,
+				.zone_area = zone->area,
+				.zone_id   = zone->id,
+			};
+			algo->stats.peaks_raw++;
+			hx_insert_peak(algo, &peak);
+		}
+	}
+
+	hx_merge_close_peaks(algo);
+
+	/*
+	 * Isolated-spike filter.
+	 *
+	 * A real fingertip lifts its eight neighbours with it, so nbr_sum runs
+	 * a few times the peak value; impulse noise does not.  Express the
+	 * gate as a fraction of the peak in Q8:
+	 *
+	 *	keep when  nbr_sum * 256 >= z * iso_nbr_ratio_q8
+	 *
+	 * The historical test was (z >> 5) <= nbr_sum, i.e. a ratio of 8/256.
+	 * For a peak sitting at the 800 threshold that only rejects a spike
+	 * whose eight neighbours sum to under 25, which ambient noise clears
+	 * easily -- in practice it never fired.  The default below reproduces
+	 * it exactly; raise it (128 = neighbours must carry half the peak) to
+	 * actually reject single-cell contacts.
+	 */
+	{
+		u8 dst = 0, i;
+
+		for (i = 0; i < algo->peak_count; i++) {
+			s64 have = (s64)algo->peaks[i].nbr_sum * 256;
+			s64 need = (s64)algo->peaks[i].z * algo->iso_nbr_ratio_q8;
+
+			if (have >= need)
+				algo->peaks[dst++] = algo->peaks[i];
+			else
+				algo->stats.rej_isolated++;
+		}
+		algo->peak_count = dst;
+	}
+
+	/*
+	 * Minimum-area filter.
+	 *
+	 * Away from the border a contact must occupy at least two cells.  On
+	 * the border the historical code exempted the peak outright, because
+	 * a finger there has half its footprint off-grid -- but that
+	 * exemption is also the cheapest route from one noisy border cell to
+	 * a reported touch, and hx_edge_boost() has just scaled border cells
+	 * by 1 + edge_boost_pct/100 (corners twice, multiplicatively).
+	 * edge_min_area makes the exemption tunable: 1 is the historical
+	 * behaviour, 2 requires a border contact to have at least one
+	 * above-threshold neighbour.  min_area is the same away from the
+	 * border (2 historically).
+	 */
+	{
+		u8 dst = 0, i;
+
+		for (i = 0; i < algo->peak_count; i++) {
+			bool on_edge = (algo->peaks[i].r == 0 ||
+					algo->peaks[i].r == HX_ROWS - 1 ||
+					algo->peaks[i].c == 0 ||
+					algo->peaks[i].c == HX_COLS - 1);
+			u16 min_area = on_edge ? algo->edge_min_area : algo->min_area;
+
+			if (algo->peaks[i].zone_area >= min_area)
+				algo->peaks[dst++] = algo->peaks[i];
+			else
+				algo->stats.rej_minarea++;
+		}
+		algo->peak_count = dst;
+	}
+
+	/*
+	 * Edge peak filter: weak edge peaks < max_sig * 5/8.  edge_peak_mode
+	 * 0 compares the peaks on each of the four borders with the strongest
+	 * peak on it; 1 compares the peaks on the first and last column with
+	 * the strongest cell of that column, as the EGoTouchRev service does.
+	 */
+	if (algo->edge_peak_mode == 1) {
+		hx_drop_weak_column_peaks(algo, 0);
+		hx_drop_weak_column_peaks(algo, HX_COLS - 1);
+	} else {
+		int edge;
+
+		for (edge = 0; edge < 4; edge++) {
+			s16 max_sig = 0, cutoff;
+			u8 dst = 0, i;
+
+			for (i = 0; i < algo->peak_count; i++) {
+				bool on_edge;
+
+				switch (edge) {
+				case 0:  on_edge = algo->peaks[i].r == 0; break;
+				case 1:  on_edge = algo->peaks[i].r == HX_ROWS - 1; break;
+				case 2:  on_edge = algo->peaks[i].c == 0; break;
+				default: on_edge = algo->peaks[i].c == HX_COLS - 1; break;
+				}
+				if (on_edge && algo->peaks[i].z > max_sig)
+					max_sig = algo->peaks[i].z;
+			}
+			if (max_sig == 0)
+				continue;
+
+			cutoff = (max_sig >> 3) * 5;
+			for (i = 0; i < algo->peak_count; i++) {
+				bool on_edge;
+
+				switch (edge) {
+				case 0:  on_edge = algo->peaks[i].r == 0; break;
+				case 1:  on_edge = algo->peaks[i].r == HX_ROWS - 1; break;
+				case 2:  on_edge = algo->peaks[i].c == 0; break;
+				default: on_edge = algo->peaks[i].c == HX_COLS - 1; break;
+				}
+				if (!(on_edge && algo->peaks[i].z < cutoff))
+					algo->peaks[dst++] = algo->peaks[i];
+				else
+					algo->stats.rej_edgeweak++;
+			}
+			algo->peak_count = dst;
+		}
+	}
+
+	/* --- Sort ascending by signal (selection sort, ≤20 elements) --- */
+	{
+		u8 i, j;
+
+		for (i = 0; i + 1 < algo->peak_count; i++) {
+			u8 min_idx = i;
+
+			for (j = i + 1; j < algo->peak_count; j++) {
+				if (algo->peaks[j].z < algo->peaks[min_idx].z)
+					min_idx = j;
+			}
+			if (min_idx != i)
+				swap(algo->peaks[i], algo->peaks[min_idx]);
+		}
+	}
+}
+
+/* ======================================================================== */
+/* Phase 2D — zone expansion + weighted centroid                            */
+/*                                                                           */
+/* For each peak, BFS-expand outward while signal >= 50% of the peak       */
+/* value.  Accumulate weighted centroid (Q8.8 fixed-point grid coords)     */
+/* using s64 intermediate products.  When the BFS meets pixels already     */
+/* owned by another peak, fall back to a 3x3 local centroid.               */
+/*                                                                           */
+/* Result: contacts[] filled, then converted to output coords [0, 65535].  */
+/* ======================================================================== */
+
+/*
+ * Compute the zone expansion threshold: ~50% of min(peak_threshold, peak_z).
+ * Uses integer multiply + shift: base * 0x40 >> 7 ≈ base * 0.5.
+ */
+static inline s16 hx_zone_thold(s16 sig_thold, s16 peak_z)
+{
+	int base = min((int)sig_thold, (int)peak_z);
+	int result = (base * 0x40) >> 7;
+
+	return (s16)max(result, 1);
+}
+
+/*
+ * Single-peak zone: BFS flood-fill weighted centroid.
+ * Returns true if the expansion was clean (no overlap with other zones).
+ */
+static bool hx_expand_single_peak(struct hx_algo *algo, int pi,
+				    struct hx_contact *ct)
+{
+	struct hx_peak *pk = &algo->peaks[pi];
+	s16 thold = hx_zone_thold(algo->peak_threshold, pk->z);
+	u8 zone_id = (u8)(pi + 1);
+	u16 head = 0, tail = 0;
+	int seed = pk->r * HX_COLS + pk->c;
+	bool clean = true;
+	s64 w_col = 0, w_row = 0;
+	s32 w_total = 0;
+	u16 area = 0;
+	s32 sig_sum = 0;
+
+	static const int dr[] = {-1, -1, -1, 0, 0, 1, 1, 1};
+	static const int dc[] = {-1,  0,  1, -1, 1, -1, 0, 1};
+
+	algo->zone_map[seed] = zone_id;
+	algo->bfs_queue[tail++] = seed;
+
+	while (head != tail) {
+		int idx = algo->bfs_queue[head++];
+		int r = idx / HX_COLS;
+		int c = idx % HX_COLS;
+		s16 sig = hx_frame_at(algo, r, c);
+		int d;
+
+		area++;
+		sig_sum += sig;
+		w_col += (s64)c * 128 * sig;
+		w_row += (s64)r * 128 * sig;
+		w_total += sig;
+
+		for (d = 0; d < 8; d++) {
+			int nr = r + dr[d];
+			int nc = c + dc[d];
+			int ni;
+
+			if (nr < 0 || nr >= HX_ROWS || nc < 0 || nc >= HX_COLS)
+				continue;
+			ni = nr * HX_COLS + nc;
+			if (algo->zone_map[ni]) {
+				if (algo->zone_map[ni] != zone_id)
+					clean = false;
+				continue;
+			}
+			if (hx_frame_at(algo, nr, nc) < thold)
+				continue;
+			algo->zone_map[ni] = zone_id;
+			algo->bfs_queue[tail++] = ni;
+		}
+	}
+
+	if (w_total > 0) {
+		ct->x = (s32)(w_col * 2 / w_total) + 0x80;
+		ct->y = (s32)(w_row * 2 / w_total) + 0x80;
+	} else {
+		ct->x = pk->c * 256 + 128;
+		ct->y = pk->r * 256 + 128;
+	}
+	ct->area = area;
+	ct->signal_sum = sig_sum;
+	ct->is_edge = (pk->r == 0 || pk->r == HX_ROWS - 1 ||
+		       pk->c == 0 || pk->c == HX_COLS - 1);
+
+	return clean;
+}
+
+/*
+ * Multi-peak fallback: 3x3 local weighted centroid around the peak.
+ */
+static void hx_local_centroid(struct hx_algo *algo, int pi,
+			       struct hx_contact *ct)
+{
+	struct hx_peak *pk = &algo->peaks[pi];
+	s64 w_col = 0, w_row = 0;
+	s32 w_total = 0;
+	u16 area = 0;
+	s32 sig_sum = 0;
+	int dr, dc;
+
+	for (dr = -1; dr <= 1; dr++) {
+		for (dc = -1; dc <= 1; dc++) {
+			int nr = pk->r + dr;
+			int nc = pk->c + dc;
+			s16 sig;
+
+			if (nr < 0 || nr >= HX_ROWS || nc < 0 || nc >= HX_COLS)
+				continue;
+			sig = hx_frame_at(algo, nr, nc);
+			if (sig <= 0)
+				continue;
+			w_col += (s64)nc * 128 * sig;
+			w_row += (s64)nr * 128 * sig;
+			w_total += sig;
+			area++;
+			sig_sum += sig;
+		}
+	}
+
+	if (w_total > 0) {
+		ct->x = (s32)(w_col * 2 / w_total) + 0x80;
+		ct->y = (s32)(w_row * 2 / w_total) + 0x80;
+	} else {
+		ct->x = pk->c * 256 + 128;
+		ct->y = pk->r * 256 + 128;
+	}
+	ct->area = area;
+	ct->signal_sum = sig_sum;
+	ct->is_edge = (pk->r == 0 || pk->r == HX_ROWS - 1 ||
+		       pk->c == 0 || pk->c == HX_COLS - 1);
+}
+
+/*
+ * Edge compensation: push centroid outward toward the physical sensor
+ * boundary.  The sensor extends ~0.5 cells beyond the last grid node,
+ * but the weighted centroid is biased inward because there's no data
+ * outside the grid.  This function linearly pushes edge contacts
+ * outward, with maximum push at the boundary itself, fading to zero
+ * at edge_blend_q8 distance from the edge.
+ */
+static void hx_edge_compensate(struct hx_algo *algo, struct hx_contact *ct)
+{
+	s32 push_max = algo->edge_push_q8;
+	s32 blend    = algo->edge_blend_q8;
+	s32 dist, push;
+
+	if (!algo->edge_comp_enabled || push_max <= 0 || blend <= 0)
+		return;
+
+	/* Left boundary: distance = ct->x (Q8.8, 0 = grid col 0 center) */
+	dist = ct->x;
+	if (dist < blend) {
+		push = push_max * (blend - dist) / blend;
+		ct->x = max_t(s32, ct->x - push, 0);
+	}
+
+	/*
+	 * Right boundary: distance from last col center.  The push stops
+	 * at the last Q8 position of the grid: one further would report one
+	 * past the axis maximum, and Android ignores a touch while it is there.
+	 */
+	dist = (HX_COLS - 1) * 256 + 128 - ct->x;
+	if (dist < blend) {
+		push = push_max * (blend - dist) / blend;
+		ct->x = min_t(s32, ct->x + push, HX_COLS * 256 - 1);
+	}
+
+	/* Top boundary */
+	dist = ct->y;
+	if (dist < blend) {
+		push = push_max * (blend - dist) / blend;
+		ct->y = max_t(s32, ct->y - push, 0);
+	}
+
+	/* Bottom boundary */
+	dist = (HX_ROWS - 1) * 256 + 128 - ct->y;
+	if (dist < blend) {
+		push = push_max * (blend - dist) / blend;
+		ct->y = min_t(s32, ct->y + push, HX_ROWS * 256 - 1);
+	}
+}
+
+/*
+ * edge_comp_mode 1: stretch the outer cell, as the EGoTouchRev service
+ * does.  A centroid within half a cell of the panel edge goes onto the
+ * edge, one between half a cell and 1.005 cells is spread linearly over
+ * 0..1.005 cells, and anything further in is left alone.  (The service
+ * takes the inner end of the first range from a log table indexed by the
+ * position along the edge, which comes out as 1/256 of a cell for all but
+ * the first eighth of each edge; this uses 1/256 throughout.)  @d is the
+ * distance from the edge in Q8 cells.
+ */
+static s32 hx_edge_stretch(s32 d)
+{
+	const s32 full = 128, blend = 129;
+	s32 t;
+
+	if (d <= full)
+		return 1;
+	if (d >= full + blend)
+		return d;
+	t = ((d - full) << 8) / blend;
+	return (d * t + (256 - t)) >> 8;
+}
+
+static void hx_edge_stretch_contact(struct hx_contact *ct)
+{
+	const s32 w = HX_COLS * 256, h = HX_ROWS * 256;
+
+	if (ct->x < 256)
+		ct->x = hx_edge_stretch(max_t(s32, ct->x, 0));
+	else if (w - ct->x < 256)
+		ct->x = w - hx_edge_stretch(max_t(s32, w - ct->x, 0));
+	if (ct->y < 256)
+		ct->y = hx_edge_stretch(max_t(s32, ct->y, 0));
+	else if (h - ct->y < 256)
+		ct->y = h - hx_edge_stretch(max_t(s32, h - ct->y, 0));
+}
+
+/*
+ * The per-contact steps both expansion paths share: carry the macro-zone
+ * area, the per-contact palm test and edge compensation.  Returns false
+ * when the contact is dropped.
+ */
+static bool hx_finish_contact(struct hx_algo *algo, int pi,
+			      struct hx_contact *ct)
+{
+	/*
+	 * ct->area is measured at half the peak and so is roughly the same
+	 * for a fingertip and for a fragment of a palm (measured on the
+	 * panel: 8-20 vs 5-21 cells).  The macro-zone area at the absolute
+	 * threshold is the quantity that can tell them apart; carry it along
+	 * so the contact log can show it.
+	 */
+	ct->zone_area = algo->peaks[pi].zone_area;
+
+	/*
+	 * Per-contact palm test.  ct->area counts only cells at or above
+	 * half the peak, so it measures this contact rather than whatever
+	 * it happens to be connected to -- the right granularity for
+	 * telling a fingertip from the heel of a hand beside it.
+	 * 0 disables it, which is the shipped default.
+	 */
+	if (algo->palm_contact_area &&
+	    ct->area >= algo->palm_contact_area) {
+		algo->stats.rej_contact_area++;
+		return false;
+	}
+
+	if (algo->edge_comp_mode == 1) {
+		if (algo->edge_comp_enabled)
+			hx_edge_stretch_contact(ct);
+	} else if (ct->is_edge) {
+		/* Push edge centroids outward toward physical sensor boundary */
+		hx_edge_compensate(algo, ct);
+	}
+	return true;
+}
+
+/*
+ * Zone split (zone_split), after the EGoTouchRev service's zone expander.
+ *
+ * Peaks are taken weakest first.  Each one that no earlier zone has
+ * reached floods out over the cells at or above its expansion threshold
+ * and also claims the still-positive cells around them, which take no part
+ * in its centroid but stop other zones.  A stronger peak the flood reached
+ * is not grown again; it joins that zone.  A zone with one peak reports its
+ * centroid; a zone with several -- fingers close enough to merge -- is
+ * divided between them by a priority flood (cells are handed out from the
+ * highest signal down, each to the peak whose part reaches it first) and
+ * each part reports its own centroid.  Without it the weaker peak kept the
+ * centroid of the whole merged blob, pulled toward the other finger, and the
+ * stronger one fell back to a 3x3 centroid.
+ */
+static const int hx_dr[] = {-1, -1, -1, 0, 0, 1, 1, 1};
+static const int hx_dc[] = {-1,  0,  1, -1, 1, -1, 0, 1};
+
+static void hx_split_claim(struct hx_algo *algo, int idx, u8 zid)
+{
+	algo->zone_map[idx] = zid;
+	algo->zone_cells[algo->zone_cell_count++] = idx;
+}
+
+static void hx_split_add(struct hx_zone_unit *u, int r, int c, s16 sig)
+{
+	u->area++;
+	u->sig_sum += sig;
+	if (sig > 0) {
+		u->w_col += (s64)c * 128 * sig;
+		u->w_row += (s64)r * 128 * sig;
+		u->w_total += sig;
+	}
+}
+
+static void hx_split_flood(struct hx_algo *algo, int pi)
+{
+	const struct hx_peak *pk = &algo->peaks[pi];
+	struct hx_zone_unit *u = &algo->units[pi];
+	int seed = pk->r * HX_COLS + pk->c;
+	u16 head = 0, tail = 0;
+	u8 zid = pi + 1;
+
+	u->thold = hx_zone_thold(algo->peak_threshold, pk->z);
+	u->peaks[u->n_peaks++] = pi;
+	hx_split_claim(algo, seed, zid);
+	hx_split_add(u, pk->r, pk->c, pk->z);
+	algo->bfs_queue[tail++] = seed;
+
+	while (head != tail) {
+		int idx = algo->bfs_queue[head++];
+		int r = idx / HX_COLS, c = idx % HX_COLS, d;
+
+		for (d = 0; d < 8; d++) {
+			int nr = r + hx_dr[d], nc = c + hx_dc[d], ni;
+			s16 sig;
+
+			if (nr < 0 || nr >= HX_ROWS || nc < 0 || nc >= HX_COLS)
+				continue;
+			ni = nr * HX_COLS + nc;
+			if (algo->zone_map[ni])
+				continue;
+			sig = algo->frame[nr][nc];
+			if (sig >= u->thold) {
+				hx_split_claim(algo, ni, zid);
+				hx_split_add(u, nr, nc, sig);
+				algo->bfs_queue[tail++] = ni;
+			} else if (sig > 0) {
+				hx_split_claim(algo, ni, zid);
+			}
+		}
+	}
+}
+
+/*
+ * Close the zone map: an empty cell with at least three neighbours of one
+ * zone joins it, unless it then still borders an empty cell.  This only
+ * bridges gaps for the partition below.
+ */
+static void hx_split_close(struct hx_algo *algo)
+{
+	u16 n_cand = 0, n_new = 0, i;
+	int d;
+
+	memcpy(algo->split_prev, algo->zone_map, sizeof(algo->split_prev));
+	for (i = 0; i < algo->zone_cell_count; i++) {
+		int idx = algo->zone_cells[i];
+		int r = idx / HX_COLS, c = idx % HX_COLS;
+
+		for (d = 0; d < 8; d++) {
+			int nr = r + hx_dr[d], nc = c + hx_dc[d], ni;
+
+			if (nr < 0 || nr >= HX_ROWS || nc < 0 || nc >= HX_COLS)
+				continue;
+			ni = nr * HX_COLS + nc;
+			if (algo->split_prev[ni] || algo->split_mask[ni])
+				continue;
+			algo->split_mask[ni] = 1;
+			algo->split_cand[n_cand++] = ni;
+		}
+	}
+
+	for (i = 0; i < n_cand; i++) {
+		int idx = algo->split_cand[i];
+		int r = idx / HX_COLS, c = idx % HX_COLS;
+		u8 votes[HX_MAX_PEAKS + 1] = { 0 };
+		u8 best = 0, best_cnt = 0;
+
+		for (d = 0; d < 8; d++) {
+			int nr = r + hx_dr[d], nc = c + hx_dc[d];
+			u8 z;
+
+			if (nr < 0 || nr >= HX_ROWS || nc < 0 || nc >= HX_COLS)
+				continue;
+			z = algo->split_prev[nr * HX_COLS + nc];
+			if (!z || z > HX_MAX_PEAKS)
+				continue;
+			if (++votes[z] > best_cnt) {
+				best_cnt = votes[z];
+				best = z;
+			}
+		}
+		if (best_cnt >= 3) {
+			algo->zone_map[idx] = best;
+			algo->split_new[n_new++] = idx;
+		}
+	}
+
+	for (i = 0; i < n_new; i++) {
+		int idx = algo->split_new[i];
+		int r = idx / HX_COLS, c = idx % HX_COLS;
+
+		for (d = 0; d < 8; d++) {
+			int nr = r + hx_dr[d], nc = c + hx_dc[d];
+
+			if (nr < 0 || nr >= HX_ROWS || nc < 0 || nc >= HX_COLS)
+				continue;
+			if (!algo->zone_map[nr * HX_COLS + nc]) {
+				algo->zone_map[idx] = 0;
+				break;
+			}
+		}
+	}
+
+	for (i = 0; i < n_cand; i++)
+		algo->split_mask[algo->split_cand[i]] = 0;
+}
+
+/*
+ * Priority-flood keys: signal first, then the lower owner, then the lower
+ * cell index, so the order matches the service's exactly.
+ */
+static inline u32 hx_split_key(s16 sig, u8 owner, int idx)
+{
+	return ((u32)(sig + 32768) << 16) | ((u32)(16 - owner) << 12) |
+	       (u32)(4095 - idx);
+}
+
+static void hx_split_push(struct hx_algo *algo, u16 *n, u32 key)
+{
+	u32 *h = algo->split_heap;
+	u16 i = (*n)++;
+
+	while (i > 0 && h[(i - 1) / 2] < key) {
+		h[i] = h[(i - 1) / 2];
+		i = (i - 1) / 2;
+	}
+	h[i] = key;
+}
+
+static u32 hx_split_pop(struct hx_algo *algo, u16 *n)
+{
+	u32 *h = algo->split_heap;
+	u32 top = h[0], last = h[--(*n)];
+	u16 i = 0;
+
+	for (;;) {
+		u16 l = 2 * i + 1, r = l + 1, big = i;
+		u32 v = last;
+
+		if (l < *n && h[l] > v) {
+			big = l;
+			v = h[l];
+		}
+		if (r < *n && h[r] > v)
+			big = r;
+		if (big == i)
+			break;
+		h[i] = h[big];
+		i = big;
+	}
+	if (*n)
+		h[i] = last;
+	return top;
+}
+
+static void hx_split_contact(struct hx_algo *algo, int pi, s64 w_col,
+			     s64 w_row, s32 w_total, u16 area, s32 sig_sum)
+{
+	const struct hx_peak *pk = &algo->peaks[pi];
+	struct hx_contact ct;
+	u8 k, weakest = 0;
+
+	if (w_total > 0) {
+		ct.x = (s32)(w_col * 2 / w_total) + 0x80;
+		ct.y = (s32)(w_row * 2 / w_total) + 0x80;
+	} else {
+		ct.x = pk->c * 256 + 128;
+		ct.y = pk->r * 256 + 128;
+	}
+	ct.area = area;
+	ct.signal_sum = sig_sum;
+	ct.is_edge = (pk->r == 0 || pk->r == HX_ROWS - 1 ||
+		      pk->c == 0 || pk->c == HX_COLS - 1);
+	if (!hx_finish_contact(algo, pi, &ct))
+		return;
+
+	/* With every slot taken, the contact with the least signal goes. */
+	if (algo->contact_count < HIMAX_MAX_TOUCH) {
+		algo->contacts[algo->contact_count++] = ct;
+		return;
+	}
+	for (k = 1; k < HIMAX_MAX_TOUCH; k++)
+		if (algo->contacts[k].signal_sum < algo->contacts[weakest].signal_sum)
+			weakest = k;
+	if (ct.signal_sum > algo->contacts[weakest].signal_sum)
+		algo->contacts[weakest] = ct;
+}
+
+static void hx_split_partition(struct hx_algo *algo, int pi)
+{
+	const struct hx_zone_unit *u = &algo->units[pi];
+	struct {
+		s64 w_col, w_row;
+		s32 w_total, sig_sum;
+		u16 area;
+		u8  peak;
+	} part[HX_SPLIT_PEAKS] = { };
+	u8 zid = pi + 1, n = 0, j;
+	u16 heap_n = 0;
+	int i;
+
+	memset(algo->split_owner, 0, sizeof(algo->split_owner));
+	for (j = 0; j < u->n_peaks; j++) {
+		const struct hx_peak *pk = &algo->peaks[u->peaks[j]];
+		int idx = pk->r * HX_COLS + pk->c;
+
+		if (algo->zone_map[idx] != zid || algo->split_owner[idx])
+			continue;
+		part[n].peak = u->peaks[j];
+		algo->split_owner[idx] = ++n;
+		hx_split_push(algo, &heap_n, hx_split_key(pk->z, n, idx));
+	}
+
+	while (heap_n) {
+		u32 key = hx_split_pop(algo, &heap_n);
+		int idx = 4095 - (key & 0xfff);
+		u8 owner = 16 - ((key >> 12) & 0xf);
+		int r = idx / HX_COLS, c = idx % HX_COLS, d;
+
+		for (d = 0; d < 8; d++) {
+			int nr = r + hx_dr[d], nc = c + hx_dc[d], ni;
+
+			if (nr < 0 || nr >= HX_ROWS || nc < 0 || nc >= HX_COLS)
+				continue;
+			ni = nr * HX_COLS + nc;
+			if (algo->zone_map[ni] != zid || algo->split_owner[ni])
+				continue;
+			algo->split_owner[ni] = owner;
+			hx_split_push(algo, &heap_n,
+				      hx_split_key(algo->frame[nr][nc], owner, ni));
+		}
+	}
+
+	for (i = 0; i < HX_PIXELS; i++) {
+		u8 owner = algo->split_owner[i];
+		s16 sig = algo->frame[i / HX_COLS][i % HX_COLS];
+
+		if (!owner || sig < u->thold)
+			continue;
+		part[owner - 1].area++;
+		part[owner - 1].sig_sum += sig;
+		if (sig > 0) {
+			part[owner - 1].w_col += (s64)(i % HX_COLS) * 128 * sig;
+			part[owner - 1].w_row += (s64)(i / HX_COLS) * 128 * sig;
+			part[owner - 1].w_total += sig;
+		}
+	}
+
+	for (j = 0; j < n; j++)
+		if (part[j].area)
+			hx_split_contact(algo, part[j].peak, part[j].w_col,
+					 part[j].w_row, part[j].w_total,
+					 part[j].area, part[j].sig_sum);
+}
+
+static void hx_split_resolve(struct hx_algo *algo)
+{
+	int pi, pj;
+
+	memset(algo->units, 0, sizeof(algo->units));
+	algo->zone_cell_count = 0;
+
+	for (pi = 0; pi < algo->peak_count; pi++) {
+		const struct hx_peak *pk = &algo->peaks[pi];
+
+		if (!algo->zone_map[pk->r * HX_COLS + pk->c])
+			hx_split_flood(algo, pi);
+	}
+
+	hx_split_close(algo);
+
+	/* Peaks a weaker peak's flood reached join its zone. */
+	for (pi = 0; pi < algo->peak_count; pi++) {
+		const struct hx_peak *pk = &algo->peaks[pi];
+		u8 zid = algo->zone_map[pk->r * HX_COLS + pk->c];
+		struct hx_zone_unit *u;
+		u8 k;
+
+		if (!zid)
+			continue;
+		u = &algo->units[zid - 1];
+		if (!u->area)
+			continue;
+		for (k = 0; k < u->n_peaks && u->peaks[k] != pi; k++)
+			;
+		if (k == u->n_peaks && u->n_peaks < HX_SPLIT_PEAKS)
+			u->peaks[u->n_peaks++] = pi;
+	}
+
+	for (pj = 0; pj < algo->peak_count; pj++) {
+		const struct hx_zone_unit *u = &algo->units[pj];
+
+		if (!u->area || u->w_total == 0)
+			continue;
+		if (u->n_peaks >= 2)
+			hx_split_partition(algo, pj);
+		else
+			hx_split_contact(algo, pj, u->w_col, u->w_row,
+					 u->w_total, u->area, u->sig_sum);
+	}
+}
+
+void hx_expand_and_resolve(struct hx_algo *algo,
+			    struct input_mt_pos *pos, int *cnt)
+{
+	int i, n;
+
+	memset(algo->zone_map, 0, sizeof(algo->zone_map));
+	algo->contact_count = 0;
+
+	if (algo->zone_split) {
+		hx_split_resolve(algo);
+		goto out;
+	}
+
+	/*
+	 * peaks[] is sorted ascending, so with more peaks than slots the
+	 * strongest are the last ones.  Taking the first HIMAX_MAX_TOUCH
+	 * dropped exactly those; skip the weakest instead and keep the
+	 * ascending expansion order among the rest.
+	 */
+	n = algo->peak_count;
+	i = n > HIMAX_MAX_TOUCH ? n - HIMAX_MAX_TOUCH : 0;
+
+	for (; i < n; i++) {
+		struct hx_contact *ct = &algo->contacts[algo->contact_count];
+		bool clean;
+
+		clean = hx_expand_single_peak(algo, i, ct);
+		if (!clean)
+			hx_local_centroid(algo, i, ct);
+		if (hx_finish_contact(algo, i, ct))
+			algo->contact_count++;
+	}
+
+	/* If more peaks than slots, keep the strongest signal_sum contacts */
+	if (algo->contact_count > HIMAX_MAX_TOUCH) {
+		/* Selection-sort descending by signal_sum, keep first MAX */
+		u8 ci, cj;
+
+		for (ci = 0; ci + 1 < algo->contact_count; ci++) {
+			u8 best = ci;
+
+			for (cj = ci + 1; cj < algo->contact_count; cj++) {
+				if (algo->contacts[cj].signal_sum >
+				    algo->contacts[best].signal_sum)
+					best = cj;
+			}
+			if (best != ci)
+				swap(algo->contacts[ci], algo->contacts[best]);
+		}
+		algo->contact_count = HIMAX_MAX_TOUCH;
+	}
+
+out:
+	/* Convert Q8.8 grid coordinates to output space matching rxtx2xy:
+	 *   x = ct->x / 6       (maps to [~21, ~2539])
+	 *   y = 5 * ct->y / 32  (maps to [~20, ~1580])
+	 * This matches the coordinate range the DT/touchscreen_properties
+	 * are calibrated for.
+	 */
+	algo->stats.contacts += algo->contact_count;
+	*cnt = algo->contact_count;
+	for (i = 0; i < *cnt; i++) {
+		struct hx_contact *ct = &algo->contacts[i];
+
+		pos[i].x = clamp_val((s32)(ct->x / 6), 0, SZ_64K - 1);
+		pos[i].y = clamp_val((s32)(5 * ct->y / 32), 0, SZ_64K - 1);
+	}
+}
+
+/* ======================================================================== */
+/* Phase 3A — greedy distance-matching tracker                              */
+/* ======================================================================== */
+
+/*
+ * Squared distance from a detection to a track's *predicted* position.
+ * Prediction: next_pos = current_pos + velocity.
+ */
+static inline s64 hx_dist2_predicted(const struct input_mt_pos *a,
+				       const struct hx_track *b)
+{
+	s32 pred_x = b->x + b->vx;
+	s32 pred_y = b->y + b->vy;
+	s32 dx = a->x - pred_x;
+	s32 dy = a->y - pred_y;
+
+	return (s64)dx * dx + (s64)dy * dy;
+}
+
+struct hx_match_candidate {
+	u8  track_idx;
+	u8  det_idx;
+	s64 dist2;
+};
+
+static void hx_reset_track(struct hx_track *trk)
+{
+	memset(trk, 0, sizeof(*trk));
+}
+
+/*
+ * Position filter: a One Euro filter (Casiez et al., CHI 2012) per track.
+ *
+ * Without smoothing the centroid wobbles by a few units from frame to
+ * frame, which shows as a shaking point during a slow slide, worse on
+ * battery where the signal is weaker.  track_smoothing's fixed 1/4 step
+ * steadies it but lags about three frames at every speed, which blunts
+ * flicks.  This filter's cutoff rises with speed instead:
+ *
+ *	cutoff = mincutoff + beta * speed
+ *
+ * so a slow slide is smoothed hard and a flick passes almost as measured.
+ * The velocity is how far the measurement is from the filtered position,
+ * per second, low-passed per axis at dcutoff; the speed is its magnitude.
+ * Matching and prediction keep using x/y;
+ * only the reported position is filtered.  It starts on the down position,
+ * so a touch-down is reported without lag.
+ */
+#define HX_FILTER_HZ		120	/* frames per second while touched */
+#define HX_FILTER_MAX_MHZ	10000000
+
+/* One frame of a first-order low-pass at @mhz: w / (1 + w), w = 2 pi f / rate, Q16. */
+static u32 hx_filter_alpha(s64 mhz)
+{
+	u64 w = (u64)clamp_t(s64, mhz, 0, HX_FILTER_MAX_MHZ) * 6283;
+
+	return div64_u64(w << 16, w + (u64)HX_FILTER_HZ * 1000000);
+}
+
+static void hx_filter_reset(struct hx_track *trk)
+{
+	trk->fx = trk->x << 8;
+	trk->fy = trk->y << 8;
+	trk->fvx = 0;
+	trk->fvy = 0;
+}
+
+/* Start the filter from where the contact is now, moving as it is moving. */
+static void hx_filter_snap(struct hx_track *trk)
+{
+	trk->fx = trk->x << 8;
+	trk->fy = trk->y << 8;
+	trk->fvx = trk->vx * HX_FILTER_HZ;
+	trk->fvy = trk->vy * HX_FILTER_HZ;
+}
+
+static void hx_filter_update(const struct hx_algo *algo, struct hx_track *trk)
+{
+	s32 ex = (trk->x << 8) - trk->fx;
+	s32 ey = (trk->y << 8) - trk->fy;
+	u32 speed, a;
+
+	if (algo->track_filter_mincutoff <= 0) {
+		/* Off: follow the measurement, so turning it on does not jump. */
+		hx_filter_reset(trk);
+		return;
+	}
+	a = hx_filter_alpha(algo->track_filter_dcutoff);
+	trk->fvx += ((s64)a * (((s64)ex * HX_FILTER_HZ >> 8) - trk->fvx)) >> 16;
+	trk->fvy += ((s64)a * (((s64)ey * HX_FILTER_HZ >> 8) - trk->fvy)) >> 16;
+	speed = int_sqrt64((s64)trk->fvx * trk->fvx + (s64)trk->fvy * trk->fvy);
+	a = hx_filter_alpha(algo->track_filter_mincutoff +
+			    (s64)max(algo->track_filter_beta, 0) * speed);
+	trk->fx += ((s64)a * ex + (1 << 15)) >> 16;
+	trk->fy += ((s64)a * ey + (1 << 15)) >> 16;
+}
+
+/*
+ * Has an anchored track started to move?  A radius alone has to clear the jump
+ * of a tap's centroid as the finger lifts, and so holds a flick back until it
+ * has gone that far.  Two things tell the two apart.  The lifting centroid
+ * jumps while the signal collapses: under track_tap_fall percent of the touch's
+ * peak only track_tap_hard releases.  And once the landing has settled a tap
+ * stays put, so a single step of track_tap_speed units is the finger moving.
+ */
+static bool hx_track_left_anchor(const struct hx_algo *algo,
+				 const struct hx_track *trk)
+{
+	s64 ax = trk->x - trk->ref_x;
+	s64 ay = trk->y - trk->ref_y;
+	s64 d2 = ax * ax + ay * ay;
+	s64 r = algo->track_tap_radius;
+	s64 hard = max_t(s64, algo->track_tap_hard, r);
+	s64 v = algo->track_tap_speed;
+
+	if (r <= 0 || d2 > hard * hard)
+		return true;
+	if (algo->track_tap_fall > 0 &&
+	    (s64)trk->signal_sum * 100 < (s64)algo->track_tap_fall * trk->sig_peak)
+		return false;
+	return d2 > r * r ||
+	       (v > 0 && (s64)trk->vx * trk->vx + (s64)trk->vy * trk->vy >= v * v);
+}
+
+/* The touch moves: from here on it reports the contact, not the down position. */
+static void hx_track_unanchor(const struct hx_algo *algo, struct hx_track *trk)
+{
+	trk->anchored = false;
+	if (algo->track_tap_snap && algo->track_filter_mincutoff > 0)
+		hx_filter_snap(trk);
+}
+
+/*
+ * Row ghost (ghost_row_filter), after the EGoTouchRev service's tracker.
+ * On a poorly grounded or charger-coupled panel a finger can raise a weaker
+ * false peak elsewhere on its own sensor row.  With two or three contacts
+ * on the panel, a new one whose centroid lies on the same row as another
+ * contact with at least twice its signal is not started; it is looked at
+ * again next frame.
+ */
+static bool hx_row_ghost(struct hx_algo *algo, int det_cnt, int j)
+{
+	const struct hx_contact *a = &algo->contacts[j];
+	int k;
+
+	if (!algo->ghost_row_filter || det_cnt < 2 || det_cnt > 3 ||
+	    j >= algo->contact_count)
+		return false;
+
+	for (k = 0; k < det_cnt && k < algo->contact_count; k++) {
+		const struct hx_contact *b = &algo->contacts[k];
+
+		if (k == j || (a->y + 128) >> 8 != (b->y + 128) >> 8)
+			continue;
+		if ((s64)a->signal_sum * 2 < b->signal_sum) {
+			algo->stats.rej_row_ghost++;
+			return true;
+		}
+	}
+	return false;
+}
+
+void hx_track_contacts(struct hx_algo *algo,
+		       struct input_mt_pos *det, int det_cnt)
+{
+	bool det_used[HIMAX_MAX_TOUCH]     = { false };
+	bool track_matched[HIMAX_MAX_TOUCH] = { false };
+	u16  jump_released = 0;  /* bitmask: slots freed by jump detection */
+	u16  freed = 0;          /* bitmask: slots freed this frame         */
+	u16  born = 0;           /* bitmask: slots started this frame       */
+	struct hx_match_candidate cand[HIMAX_MAX_TOUCH * HIMAX_MAX_TOUCH];
+	int cand_cnt = 0;
+	int i, j, k;
+	u8 lost;
+
+	/*
+	 * A track reported as a palm last frame has served its purpose; one
+	 * flagged this frame is held for exactly one report as a palm.
+	 * Neither takes part in matching.
+	 */
+	for (i = 0; i < HIMAX_MAX_TOUCH; i++) {
+		struct hx_track *trk = &algo->tracks[i];
+
+		if (trk->palm == HX_TRK_PALM_SENT) {
+			hx_reset_track(trk);
+			freed |= 1u << i;
+		} else if (trk->palm == HX_TRK_PALM_NEW)
+			track_matched[i] = true;
+	}
+
+	/*
+	 * Build a candidate list of (track, detection) pairs within the
+	 * maximum allowed squared distance.
+	 */
+	for (i = 0; i < HIMAX_MAX_TOUCH; i++) {
+		struct hx_track *trk = &algo->tracks[i];
+
+		if (!trk->active || trk->palm)
+			continue;
+
+		for (j = 0; j < det_cnt; j++) {
+			s64 d2 = hx_dist2_predicted(&det[j], trk);
+
+			if (d2 > algo->track_dist2_max)
+				continue;
+
+			cand[cand_cnt].track_idx = i;
+			cand[cand_cnt].det_idx   = j;
+			cand[cand_cnt].dist2     = d2;
+			cand_cnt++;
+		}
+	}
+
+	/* Selection-sort candidates by distance (max 100 entries). */
+	for (i = 0; i < cand_cnt; i++) {
+		int best = i;
+
+		for (j = i + 1; j < cand_cnt; j++) {
+			if (cand[j].dist2 < cand[best].dist2 ||
+			    (cand[j].dist2 == cand[best].dist2 &&
+			     cand[j].track_idx < cand[best].track_idx) ||
+			    (cand[j].dist2 == cand[best].dist2 &&
+			     cand[j].track_idx == cand[best].track_idx &&
+			     cand[j].det_idx < cand[best].det_idx))
+				best = j;
+		}
+		if (best != i)
+			swap(cand[i], cand[best]);
+	}
+
+	/* Greedy assignment: take the shortest-distance uncontested pair. */
+	for (k = 0; k < cand_cnt; k++) {
+		struct hx_match_candidate *m = &cand[k];
+		struct hx_track *trk;
+
+		if (track_matched[m->track_idx] || det_used[m->det_idx])
+			continue;
+
+		trk = &algo->tracks[m->track_idx];
+		if (!trk->active || trk->palm)
+			continue;
+
+		/* Jump detection: a detection that lands far from where this
+		 * track was heading is a finger swap, not a slide.  Release
+		 * the old slot and let the detection spawn a new track at a
+		 * *different* slot so that lift + press both appear in the
+		 * same SYN_REPORT (zero added latency).
+		 *
+		 * The test is the deviation from the *predicted* position,
+		 * which is what m->dist2 already holds.  Comparing the raw
+		 * displacement instead makes the threshold a disguised speed
+		 * limit: a smooth slide faster than sqrt(track_jump_dist2)
+		 * units per frame trips it every frame, and because the
+		 * replacement track starts at debounce_base and is only
+		 * eligible again at age >= 2, it can never reach debounce 0.
+		 * The contact then stops being reported for as long as the
+		 * finger keeps moving that fast.  With the shipped 6400 that
+		 * limit was 80 units/frame -- about 1 m/s on this panel, well
+		 * inside normal flick-scrolling, and measured on the device as
+		 * one swipe arriving as ~15 separate contacts.
+		 */
+		if (algo->track_jump_dist2 > 0 && trk->age >= 2 &&
+		    m->dist2 > algo->track_jump_dist2) {
+			algo->stats.tracks_jump++;
+			hx_reset_track(trk);
+			jump_released |= (1u << m->track_idx);
+			track_matched[m->track_idx] = true;
+			/* det stays unused → picked up by new-slot logic */
+			continue;
+		}
+
+		/* Update position: smooth or direct. */
+		trk->vx = det[m->det_idx].x - trk->x;
+		trk->vy = det[m->det_idx].y - trk->y;
+		if (algo->track_smoothing) {
+			trk->x = (trk->x * 3 + det[m->det_idx].x) / 4;
+			trk->y = (trk->y * 3 + det[m->det_idx].y) / 4;
+		} else {
+			trk->x = det[m->det_idx].x;
+			trk->y = det[m->det_idx].y;
+		}
+		trk->missed = 0;
+		if (m->det_idx < algo->contact_count)
+			trk->signal_sum = algo->contacts[m->det_idx].signal_sum;
+		trk->sig_peak = max(trk->sig_peak, trk->signal_sum);
+		if (trk->age < U8_MAX)
+			trk->age++;
+		if (trk->debounce > 0) {
+			trk->debounce--;
+			/* Reported from now on: this is the down position. */
+			if (trk->debounce == 0) {
+				trk->anchor_x = trk->ref_x = trk->x;
+				trk->anchor_y = trk->ref_y = trk->y;
+				hx_filter_reset(trk);
+			}
+		} else if (trk->age == 2 && trk->anchored &&
+			   algo->track_tap_radius > 0) {
+			s64 ax = trk->x - trk->ref_x;
+			s64 ay = trk->y - trk->ref_y;
+			/* Positions span fewer than 4096 units: cap it there. */
+			s64 r2 = 2 * (s64)min_t(s32, algo->track_tap_radius, 4096);
+
+			/*
+			 * Reported in the frame it was born: the contact was
+			 * still growing then and its centroid moves a few
+			 * units more (median 9, 15% over 20 on the panel).
+			 * Keep reporting that first position but measure the
+			 * lock from here, where it has settled -- unless it
+			 * moved more than twice the radius, which is the
+			 * finger, not the contact.
+			 */
+			hx_filter_update(algo, trk);
+			if (ax * ax + ay * ay > r2 * r2) {
+				hx_track_unanchor(algo, trk);
+			} else {
+				trk->ref_x = trk->x;
+				trk->ref_y = trk->y;
+			}
+		} else {
+			hx_filter_update(algo, trk);
+			/* Released for good once it moves; also when the lock is off. */
+			if (trk->anchored && hx_track_left_anchor(algo, trk))
+				hx_track_unanchor(algo, trk);
+		}
+
+		track_matched[m->track_idx] = true;
+		det_used[m->det_idx]        = true;
+	}
+
+	/*
+	 * The wait bridges a contact that drops out under a finger.  A frame the
+	 * firmware calls empty has no finger left to wait for, so the last lift
+	 * of a touch goes out sooner.  The flag covers the whole panel: with
+	 * another finger down a lift still waits.
+	 */
+	lost = algo->track_lost_frames;
+	if (algo->base_mode && algo->baseline_fw_finger && !algo->fw_finger)
+		lost = min(lost, algo->track_fw_lost_frames);
+
+	/* Age or release unmatched tracks. */
+	for (i = 0; i < HIMAX_MAX_TOUCH; i++) {
+		struct hx_track *trk = &algo->tracks[i];
+
+		if (!trk->active || track_matched[i])
+			continue;
+
+		/*
+		 * Before the first stable touch is established, drop stray
+		 * tracks immediately to prevent noise from being reported.
+		 */
+		if (algo->track_active_guard && !algo->touch_active) {
+			algo->stats.tracks_guard_kill++;
+			hx_reset_track(trk);
+			freed |= 1u << i;
+			continue;
+		}
+
+		trk->missed++;
+		if (trk->missed > lost) {
+			algo->stats.tracks_lost++;
+			hx_reset_track(trk);
+			freed |= 1u << i;
+		}
+	}
+
+	freed |= jump_released;
+
+	/* Create new slots for unmatched detections. */
+	for (j = 0; j < det_cnt; j++) {
+		struct hx_track *trk = NULL;
+		s32 sig = j < algo->contact_count ?
+			  algo->contacts[j].signal_sum : 0;
+		u8 debounce = algo->debounce_base;
+		u16 avoid;
+
+		if (det_used[j] || hx_row_ghost(algo, det_cnt, j))
+			continue;
+
+		/*
+		 * A one-frame noise blip only becomes a touch if it is reported
+		 * in the frame it appears: track_min_signal keeps the weakest
+		 * from starting at all, and debounce_strong reports at once only
+		 * a contact strong enough to be a finger.
+		 */
+		if (algo->track_min_signal && sig < algo->track_min_signal) {
+			algo->stats.rej_weak_start++;
+			continue;
+		}
+		if (algo->debounce_strong && sig >= algo->debounce_strong) {
+			debounce = 0;
+			/*
+			 * Right next to a finger already on the panel a strong
+			 * new contact is more often a piece of that finger
+			 * split off for a frame than a landing: debounce it as
+			 * usual.  Fingers landing together are not held back.
+			 */
+			for (k = 0; k < HIMAX_MAX_TOUCH; k++) {
+				if (algo->tracks[k].active && !(born & (1u << k)) &&
+				    !algo->tracks[k].palm &&
+				    hx_dist2_predicted(&det[j], &algo->tracks[k]) <
+				    4 * (s64)algo->track_dist2_max) {
+					debounce = algo->debounce_base;
+					break;
+				}
+			}
+		}
+
+		/*
+		 * A slot keeps its tracking id for as long as it is reported in
+		 * consecutive frames, so a lift and a new touch in one slot
+		 * within one frame would read as a jump.  A track reported in
+		 * the frame it is born keeps off every slot freed this frame;
+		 * otherwise its first frame is unreported and only the slots
+		 * jump detection freed need avoiding.
+		 */
+		avoid = debounce ? jump_released : freed;
+		for (i = 0; i < HIMAX_MAX_TOUCH; i++) {
+			if (!algo->tracks[i].active && !(avoid & (1u << i))) {
+				trk = &algo->tracks[i];
+				break;
+			}
+		}
+		if (!trk)
+			continue;
+
+		born |= 1u << i;
+		trk->active   = true;
+		trk->age      = 1;
+		trk->missed   = 0;
+		trk->debounce = debounce;
+		trk->x        = det[j].x;
+		trk->y        = det[j].y;
+		trk->vx       = 0;
+		trk->vy       = 0;
+		trk->anchored = algo->track_tap_radius > 0;
+		trk->anchor_x = trk->ref_x = det[j].x;
+		trk->anchor_y = trk->ref_y = det[j].y;
+		hx_filter_reset(trk);
+		if (j < algo->contact_count)
+			trk->signal_sum = algo->contacts[j].signal_sum;
+		trk->sig_peak = trk->signal_sum;
+
+		/* Record what this contact looked like when it was born. */
+		algo->stats.tracks_new++;
+		{
+			struct hx_newlog *lg = &algo->newlog[algo->newlog_head];
+
+			lg->seq        = ++algo->newlog_seq;
+			lg->x          = det[j].x;
+			lg->y          = det[j].y;
+			lg->area       = j < algo->contact_count ?
+					     algo->contacts[j].area : 0;
+			lg->signal_sum = trk->signal_sum;
+			lg->zone_area  = j < algo->contact_count ?
+					     algo->contacts[j].zone_area : 0;
+			lg->is_edge    = j < algo->contact_count &&
+					     algo->contacts[j].is_edge;
+			if (lg->is_edge)
+				algo->stats.tracks_new_edge++;
+			algo->newlog_head = (algo->newlog_head + 1) % HX_NEWLOG;
+		}
+	}
+
+	/* This frame's report carries the palm; the next call releases it. */
+	for (i = 0; i < HIMAX_MAX_TOUCH; i++)
+		if (algo->tracks[i].palm == HX_TRK_PALM_NEW)
+			algo->tracks[i].palm = HX_TRK_PALM_SENT;
+}
+
+int hx_count_stable_tracks(struct hx_algo *algo)
+{
+	int i, cnt = 0;
+
+	for (i = 0; i < HIMAX_MAX_TOUCH; i++) {
+		if (algo->tracks[i].active && algo->tracks[i].debounce == 0)
+			cnt++;
+	}
+	return cnt;
+}
diff --git a/drivers/input/touchscreen/hx-algo.h b/drivers/input/touchscreen/hx-algo.h
new file mode 100644
index 0000000..4a7fcc5
--- /dev/null
+++ b/drivers/input/touchscreen/hx-algo.h
@@ -0,0 +1,470 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Himax HX83121A touch algorithm — data structures and interface.
+ *
+ * All algorithm state lives in struct hx_algo, which is allocated once in
+ * probe via kvzalloc and referenced from struct himax_ts_data.
+ */
+#ifndef HX_ALGO_H
+#define HX_ALGO_H
+
+#include <linux/input/mt.h>
+#include <linux/types.h>
+
+/* Grid dimensions — must match the firmware raw frame layout. */
+#define HX_ROWS        40
+#define HX_COLS        60
+#define HX_PIXELS      (HX_ROWS * HX_COLS)  /* 2400 */
+
+/* Detection limits */
+#define HX_MAX_ZONES   20
+#define HX_MAX_PEAKS   20
+#define HX_ZONE_PX_MAX 300  /* pixels stored per macro-zone; palm zones exceed
+			     * this but are caught before the limit matters */
+
+/* Maximum simultaneous reported contacts. */
+#define HIMAX_MAX_TOUCH 10
+
+/* Histogram bins for the adaptive baseline's median, centred on zero. */
+#define HX_BASE_HIST   2048
+
+/* Peaks one zone can hold when zone_split partitions it. */
+#define HX_SPLIT_PEAKS 16
+
+/*
+ * Upper limits of the hand_* tunables; sysfs rejects larger values.
+ * hand_age saturates at U8_MAX, which reads as "not hand", so the hold has
+ * to stay well below it; the same goes for the landing window, which is
+ * compared with the saturating track age.  Every dilation pass scans up to
+ * 2 * margin + 1 cells per cell.
+ */
+#define HX_HAND_MARGIN_MAX      8       /* cells, ~3.5 cm */
+#define HX_HAND_HOLD_MAX        120     /* frames, ~1 s at 120 Hz */
+#define HX_HAND_LAND_FRAMES_MAX 60      /* frames, ~0.5 s */
+#define HX_HAND_LAND_DIST_MAX   HX_COLS /* cells: the whole panel */
+
+/**
+ * struct hx_peak - single detected local-maximum candidate.
+ * @r:          row in the grid (0-based)
+ * @c:          column in the grid
+ * @z:          signal value at the peak
+ * @nbr_sum:    sum of all 8-neighbour signals (used for Z8 filter)
+ * @zone_area:  area of the macro-zone this peak belongs to
+ * @zone_id:    hx_macro_zone::id of that zone
+ */
+struct hx_peak {
+	u8  r;
+	u8  c;
+	s16 z;
+	s32 nbr_sum;
+	u16 zone_area;
+	u8  zone_id;
+};
+
+/**
+ * struct hx_contact - sub-pixel coordinate after centroid expansion.
+ * @x, @y:      Q8.8 fixed-point grid coordinates
+ * @area:       number of pixels contributing to this contact
+ * @signal_sum: integrated signal over the contact area
+ * @is_edge:    true when the centroid is within one cell of the grid boundary
+ */
+struct hx_contact {
+	s32  x;
+	s32  y;
+	u16  area;
+	s32  signal_sum;
+	bool is_edge;
+	u16  zone_area;   /* area of the macro-zone this contact came from */
+};
+
+/**
+ * struct hx_track - persistent touch slot state.
+ * @active:     slot is in use
+ * @x, @y:      current output coordinates [0, 65535]
+ * @vx, @vy:    velocity in output units per frame (for prediction)
+ * @signal_sum: integrated signal (forwarded to pressure reporting)
+ * @age:        frames the slot has been active
+ * @missed:     consecutive frames the slot had no matching detection
+ * @debounce:   remaining debounce frames before the slot is reported
+ * @palm:       HX_TRK_PALM_* once the track turned out to be part of a hand
+ */
+struct hx_track {
+	bool active;
+	s32  x;
+	s32  y;
+	s32  vx;
+	s32  vy;
+	s32  signal_sum;
+	u8   age;
+	u8   missed;
+	u8   debounce;
+	u8   palm;
+	/*
+	 * Anchor lock (track_tap_radius): until the track has moved away from
+	 * where it was first reported (debounce reaching 0; see
+	 * hx_track_left_anchor()), that down position is reported instead of
+	 * x/y.  Matching and prediction still use x/y.  The distance is taken
+	 * from ref_x/ref_y: the down position, or for a track reported in the
+	 * frame it was born the position one frame later, once the contact has
+	 * settled.
+	 */
+	bool anchored;
+	s32  anchor_x;
+	s32  anchor_y;
+	s32  ref_x;
+	s32  ref_y;
+	/* Strongest signal_sum so far, which a lifting finger falls away from. */
+	s32  sig_peak;
+	/*
+	 * Position filter (track_filter_mincutoff): the filtered position in
+	 * 1/256 units and the low-passed velocity in units per second.
+	 */
+	s32  fx;
+	s32  fy;
+	s32  fvx;
+	s32  fvy;
+};
+
+/*
+ * A reported track that turns out to be part of a hand is not lifted: a
+ * lift after a press is a tap.  It is reported once more with
+ * MT_TOOL_PALM, which userspace takes as "cancel this contact", and
+ * released on the following frame.
+ */
+#define HX_TRK_PALM_NEW   1  /* flagged this frame, report as palm      */
+#define HX_TRK_PALM_SENT  2  /* reported as palm, release on next frame */
+
+/**
+ * struct hx_macro_zone - contiguous above-threshold region.
+ * @pixels:     1-D indices (r*HX_COLS+c) of up to HX_ZONE_PX_MAX pixels
+ * @area:       total pixel count (may exceed HX_ZONE_PX_MAX for palm zones)
+ * @signal_sum: sum of positive pixel values within the zone
+ * @min_r … max_c: bounding box
+ */
+struct hx_macro_zone {
+	u16 pixels[HX_ZONE_PX_MAX];
+	u16 area;
+	s32 signal_sum;
+	u8  min_r;
+	u8  max_r;
+	u8  min_c;
+	u8  max_c;
+	bool is_palm;   /* set by hx_reject_palms(); the zone is kept */
+	u8 palm_rule;   /* which rule fired, 1-4; 0 = not a palm      */
+	u8 id;          /* per-frame id, as stored in hx_algo::zone_of */
+};
+
+/* Number of recent contact births kept for inspection. */
+#define HX_NEWLOG      16
+
+/**
+ * struct hx_stats - per-stage counters for the frame pipeline.
+ *
+ * Every stage between "a pixel crossed the threshold" and "a contact was
+ * reported" can silently drop or pass a candidate, and until these existed
+ * nothing in the driver could say which one did.  That is the question any
+ * touch complaint turns into, so the counters are cheap and always on.
+ * Free-running; reset by writing anything to the sysfs stats attribute.
+ */
+struct hx_stats {
+	u32 frames;             /* frames processed                        */
+	u32 frames_reported;    /* frames with at least one stable contact */
+	u32 zones;              /* macro-zones found                       */
+	u32 zones_evicted;      /* table full, a weaker zone was displaced */
+	u32 zones_overflow;     /* table full, the new zone lost           */
+	u32 palm_rule[5];       /* [1..4] = how often each palm rule fired */
+	u32 peaks_raw;          /* peak candidates before the filters      */
+	u32 rej_drift;          /* dropped as pressure drift               */
+	u32 rej_isolated;       /* dropped by the isolated-spike gate      */
+	u32 rej_minarea;        /* dropped by the minimum-area filter      */
+	u32 rej_edgeweak;       /* dropped as a weak edge peak             */
+	u32 rej_merged;         /* merged into a close, stronger peak      */
+	u32 rej_row_ghost;      /* new contact taken for a row ghost       */
+	u32 rej_weak_start;     /* new contact below track_min_signal      */
+	u32 fw_finger_frames;   /* frames the firmware reported a finger   */
+	u32 contacts;           /* contacts handed to the tracker          */
+	u32 rej_contact_area;   /* dropped by the per-contact palm test    */
+	u32 tracks_new;         /* slots created                           */
+	u32 tracks_new_edge;    /* ... of those, born on a grid border     */
+	u32 tracks_jump;        /* released by jump detection              */
+	u32 tracks_guard_kill;  /* killed by track_active_guard            */
+	u32 tracks_lost;        /* released after track_lost_frames        */
+	u32 hand_lands;         /* a palm appeared after a quiet spell     */
+	u32 hand_peaks;         /* peaks dropped as part of a hand         */
+	u32 hand_cancel_map;    /* tracks cancelled inside the hand map    */
+	u32 hand_cancel_land;   /* tracks cancelled landing with a palm    */
+	u8  max_contacts;       /* most simultaneous stable contacts seen  */
+};
+
+/**
+ * struct hx_newlog - what a contact looked like at the moment it was born.
+ *
+ * A ghost and a fingertip both arrive as "a new touch"; they differ in area,
+ * integrated signal and whether they sat on the grid border.  Keeping the
+ * last few makes that difference readable after the fact.
+ */
+/**
+ * struct hx_zone_unit - a zone grown from one peak when zone_split is on.
+ * @w_col, @w_row, @w_total: weighted centroid sums over the cells at or
+ *              above @thold
+ * @sig_sum:    signal over those cells
+ * @area:       number of those cells
+ * @thold:      expansion threshold of the peak that grew the zone
+ * @n_peaks:    peaks inside the zone: the one that grew it, then any it
+ *              swallowed
+ * @peaks:      their indices into hx_algo::peaks
+ */
+struct hx_zone_unit {
+	s64 w_col;
+	s64 w_row;
+	s32 w_total;
+	s32 sig_sum;
+	u16 area;
+	s16 thold;
+	u8  n_peaks;
+	u8  peaks[HX_SPLIT_PEAKS];
+};
+
+struct hx_newlog {
+	u32  seq;
+	s32  x;
+	s32  y;
+	u16  area;
+	s32  signal_sum;
+	bool is_edge;
+	u16  zone_area;
+};
+
+/**
+ * struct hx_algo - all algorithm state, allocated once in probe.
+ *
+ * Memory budget: ~95 KB, from kvzalloc.  Never allocate on the stack.
+ */
+struct hx_algo {
+	/* ---- Frame buffers ---- */
+	s16 frame[HX_ROWS][HX_COLS];        /* baseline-subtracted signal  */
+	/* Copy of frame[] straight after baseline subtraction, before CMF,
+	 * edge boost and IIR touch it.  This is the one the panel actually
+	 * produced, so it is the only place a per-pixel baseline problem
+	 * (thermal drift, a charger, water) is still visible. */
+	s16 raw_frame[HX_ROWS][HX_COLS];
+	s16 iir_history[HX_ROWS][HX_COLS];  /* IIR temporal-filter history */
+	bool iir_initialized;
+
+	/* ---- Scratch buffers (shared between pipeline stages) ---- */
+	u8  visited[HX_PIXELS];              /* BFS visited flags           */
+	u8  zone_of[HX_PIXELS];              /* hx_macro_zone::id per pixel */
+	u8  zone_map[HX_PIXELS];             /* per-pixel zone-ID map       */
+	u16 bfs_queue[HX_PIXELS];            /* ring-buffer BFS queue       */
+
+	/* ---- Adaptive baseline (baseline_mode 1) ---- */
+	s32  base_q8[HX_PIXELS];       /* per-cell baseline, 1/256 ADC units */
+	u8   base_hold[HX_PIXELS];     /* frames a released cell stays held  */
+	u16  base_hist[HX_BASE_HIST];  /* scratch: histogram for the median  */
+	bool base_init;
+	u8   base_mode;                /* baseline_mode the state belongs to */
+	bool base_prev_finger;
+	bool base_had_freeze;          /* a cell passed the gate last frame  */
+	u8   base_recovery;            /* frames spent in recovery           */
+	bool fw_finger;                /* the firmware reports a finger; set
+					* by the bus code before each frame */
+
+	/* ---- Zone split (zone_split) ---- */
+	struct hx_zone_unit units[HX_MAX_PEAKS];
+	u16 zone_cells[HX_PIXELS];     /* cells claimed, in claiming order   */
+	u16 zone_cell_count;
+	u8  split_prev[HX_PIXELS];     /* zone_map before dilation           */
+	u8  split_mask[HX_PIXELS];     /* dilation candidate already listed  */
+	u16 split_cand[HX_PIXELS];     /* dilation candidates                */
+	u16 split_new[HX_PIXELS];      /* cells the dilation added           */
+	u8  split_owner[HX_PIXELS];    /* partition owner, 1-based           */
+	u32 split_heap[HX_PIXELS];     /* priority flood, packed keys        */
+
+	/* ---- Detection results ---- */
+	struct hx_macro_zone zones[HX_MAX_ZONES];
+	u8   zone_count;
+	/* Scratch slot used to build a zone once zones[] is full, so a
+	 * late-scanned contact can still displace a weaker one. */
+	struct hx_macro_zone spare;
+
+	struct hx_peak peaks[HX_MAX_PEAKS];
+	u8   peak_count;
+
+	struct hx_contact contacts[HIMAX_MAX_TOUCH];
+	u8   contact_count;
+
+	/* ---- Tracking state ---- */
+	struct hx_track tracks[HIMAX_MAX_TOUCH];
+	bool touch_active;
+	u8   touch_start_frames;
+
+	/* ---- Hand map (hx_hand_update / hx_hand_filter) ---- */
+	u8   hand_age[HX_PIXELS];  /* frames since the cell was hand; 255 = not */
+	u8   hand_mark[HX_PIXELS]; /* scratch: cells to mark this pass        */
+	u8   mark_id[256];         /* scratch: zone ids to mark this pass     */
+	u8   hand_tmp[HX_PIXELS];  /* scratch for the dilation                */
+	u32  frame_seq;
+	u32  palm_seen_seq;        /* last frame with a palm zone             */
+	u32  palm_land_seq;        /* first frame of the current palm         */
+	bool palm_seen;
+
+	/* ---- Tunable parameters (sysfs-writable, atomically updated) ---- */
+	/* Preprocessing */
+	u8   baseline_mode;        /* 0 fixed, 1 adaptive with a gate,
+				    * 2 the same with the CMF before it   */
+	bool baseline_fw_finger;   /* adaptive: trust the firmware's finger
+				    * flag (off: assume a finger always)  */
+	s16  baseline_gate;        /* adaptive: cells above this pass      */
+	bool cmf_enabled;          /* CMF on/off (default: true)           */
+	u8   cmf_mode;             /* bit 0 rows, bit 1 columns            */
+	s16  cmf_exclusion;        /* exclude pixels > this from CMF mean  */
+	s16  cmf_max_correction;   /* clamp per-row/col offset             */
+	bool iir_enabled;          /* IIR temporal filter on/off           */
+	u16  iir_decay_weight;     /* blend weight 0-256 (256 = no blend)  */
+	u16  iir_decay_step;       /* per-frame decay in signal units      */
+	s16  iir_noise_floor;      /* clamp-to-zero below this             */
+	s16  iir_gate_floor;       /* min dynamic threshold                */
+	u8   iir_gate_ratio_q8;    /* dyn threshold = max * ratio/256      */
+	/* Detection */
+	s16  macro_threshold;      /* minimum pixel value to seed BFS      */
+	s16  peak_edge_threshold;  /* peak threshold on column 1, the next
+				    * to last column and the last row
+				    * (0 = peak_threshold)                */
+	s16  peak_drift_limit;     /* scale of the pressure-drift test
+				    * (0 = peak_threshold)                */
+	u8   peak_merge_radius;    /* drop the weaker of two peaks this
+				    * close with a shallow dip between
+				    * them (0 = off)                      */
+	u8   min_area;             /* minimum zone area for a peak         */
+	s16  peak_threshold;       /* minimum peak signal                  */
+	u16  iso_nbr_ratio_q8;     /* isolated-spike gate: keep a peak only
+	                            * when nbr_sum * 256 >= z * this        */
+	u8   edge_min_area;        /* minimum zone area for an on-edge peak
+	                            * (1 = a lone border cell still counts) */
+	bool palm_enabled;         /* palm-rejection on/off                */
+	bool palm_zone_scan;       /* also look for peaks inside palm zones */
+	u16  palm_contact_area;    /* per-contact palm test; 0 = disabled   */
+	u8   palm_area_threshold;  /* area >= this → palm                  */
+	s32  palm_signal_threshold;/* signal_sum >= this → palm            */
+	s16  palm_density_low;     /* signal/area < this → palm            */
+	bool hand_enabled;         /* hand map + palm cancel on/off        */
+	u8   hand_margin;          /* cells added around palm/hand zones   */
+	u8   hand_hold_frames;     /* how long a cell stays hand           */
+	u8   hand_land_frames;     /* window around a palm landing         */
+	u8   hand_land_dist;       /* reach from a landing palm, in cells  */
+	/* Pressure / touch-major reporting */
+	bool pressure_enabled;     /* report PRESSURE + TOUCH_MAJOR        */
+	/* Edge compensation */
+	bool edge_comp_enabled;    /* edge compensation on/off             */
+	s16  edge_boost_pct;       /* signal boost for border pixels (%)   */
+	s16  edge_push_q8;         /* max outward push in Q8.8 (128=0.5)  */
+	s16  edge_blend_q8;        /* blend range in Q8.8 (512=2 cells)   */
+	u8   edge_comp_mode;       /* 0 push, 1 stretch the outer cell     */
+	u8   edge_peak_mode;       /* 0 all edges vs the strongest edge
+				    * peak, 1 outer columns vs their
+				    * strongest cell                      */
+	bool zone_split;           /* split zones holding several peaks    */
+	/* Tracking */
+	s32  track_dist2_max;      /* max squared distance for match       */
+	u8   track_lost_frames;    /* missed frames before slot release    */
+	u8   track_fw_lost_frames; /* the same while the firmware sees no  */
+				   /* finger; never more than the above    */
+	u8   debounce_base;        /* new-slot debounce count              */
+	s32  debounce_strong;      /* a new contact with at least this
+				    * signal is reported at once, unless
+				    * track_start_debounce holds the first
+				    * touch back (0 = off)                */
+	s32  track_min_signal;     /* a new contact needs this much signal
+				    * to start a track (0 = off)          */
+	bool ghost_row_filter;     /* drop a new contact on the row of one
+				    * with twice its signal (2-3 contacts) */
+	bool track_smoothing;      /* position smoothing on/off            */
+	bool track_active_guard;   /* kill stray tracks before 1st stable  */
+	u8   track_start_debounce; /* frames to confirm touch_active       */
+	s32  track_jump_dist2;     /* position jump → force lift+repress   */
+	s32  track_tap_radius;     /* hold the down position until the     */
+				   /* track moves this far (0 = off)       */
+	s32  track_tap_speed;      /* or takes one step this long (0 = off) */
+	s32  track_tap_hard;       /* radius while the signal is falling   */
+				   /* (at least track_tap_radius)          */
+	s32  track_tap_fall;       /* falling: under this % of the touch's */
+				   /* peak signal (0 = ignore the signal)  */
+	bool track_tap_snap;       /* on release, report the contact       */
+				   /* itself, not the filter behind it     */
+	s32  track_filter_mincutoff; /* One Euro cutoff at rest, mHz (0 = off) */
+	s32  track_filter_beta;    /* cutoff added per unit/s of speed, mHz */
+	s32  track_filter_dcutoff; /* cutoff of the speed estimate, mHz    */
+
+	/* ---- Diagnostics ---- */
+	struct hx_stats  stats;
+	struct hx_newlog newlog[HX_NEWLOG];
+	u8   newlog_head;
+	u32  newlog_seq;
+};
+
+/* ---- Public API ---- */
+
+void hx_algo_init_defaults(struct hx_algo *algo);
+
+/* Phase 1: preprocessing (baseline subtraction, CMF, IIR) */
+void hx_preprocess_frame(struct hx_algo *algo, const u16 *raw);
+
+/* Phase 2A: macro-zone detection */
+void hx_detect_macro_zones(struct hx_algo *algo);
+
+/* Phase 2B: palm rejection */
+void hx_reject_palms(struct hx_algo *algo);
+
+/* Forget the hand map; with the tracks, on panel reset and power down */
+void hx_hand_reset(struct hx_algo *algo);
+
+/* Phase 2B½: record palm zones in the hand map */
+void hx_hand_update(struct hx_algo *algo);
+
+/* Phase 2C: peak detection within surviving zones */
+void hx_detect_peaks(struct hx_algo *algo);
+
+/* Phase 2C½: drop hand peaks, flag hand tracks for cancellation */
+void hx_hand_filter(struct hx_algo *algo);
+
+/* Phase 2D: zone expansion + weighted centroid → contacts → output positions */
+void hx_expand_and_resolve(struct hx_algo *algo,
+			    struct input_mt_pos *pos, int *cnt);
+
+/* Phase 3A: greedy tracker update (with velocity prediction) */
+/*
+ * The position to report for a track: its down position while the anchor
+ * lock holds, otherwise its filtered position when the filter is on, its
+ * measured position when not.
+ *
+ * A finger that taps without moving still drifts as it lifts: the contact
+ * shrinks and weakens over the last one or two frames and its centroid
+ * moves 5-10 units on its own.  Unity starts a drag at 10 px, so a tap on a
+ * scrolling list arrives as a scroll.  Holding the down position until the
+ * touch has really moved keeps such taps still; a flick moves tens of units
+ * in its first frame and is released at once, while a slow slide is held
+ * until it is the radius away from where it landed.
+ */
+static inline void hx_track_report_pos(const struct hx_algo *algo,
+				       const struct hx_track *trk,
+				       s32 *x, s32 *y)
+{
+	if (algo->track_tap_radius > 0 && trk->anchored) {
+		*x = trk->anchor_x;
+		*y = trk->anchor_y;
+	} else if (algo->track_filter_mincutoff > 0) {
+		*x = (trk->fx + 128) >> 8;
+		*y = (trk->fy + 128) >> 8;
+	} else {
+		*x = trk->x;
+		*y = trk->y;
+	}
+}
+
+void hx_track_contacts(struct hx_algo *algo,
+		       struct input_mt_pos *det, int det_cnt);
+
+/* Count slots that have passed debounce */
+int hx_count_stable_tracks(struct hx_algo *algo);
+
+#endif /* HX_ALGO_H */
diff --git a/drivers/iommu/arm/arm-smmu/arm-smmu-qcom.c b/drivers/iommu/arm/arm-smmu/arm-smmu-qcom.c
index e2c914f..8fe910c 100644
--- a/drivers/iommu/arm/arm-smmu/arm-smmu-qcom.c
+++ b/drivers/iommu/arm/arm-smmu/arm-smmu-qcom.c
@@ -8,8 +8,10 @@
 #include <linux/delay.h>
 #include <linux/of_device.h>
 #include <linux/firmware/qcom/qcom_scm.h>
+#include <linux/interrupt.h>
 #include <linux/platform_device.h>
 #include <linux/pm_runtime.h>
+#include <linux/qcom_iommu_cp_nonpixel.h>
 
 #include "arm-smmu.h"
 #include "arm-smmu-qcom.h"
@@ -447,6 +449,275 @@ static int qcom_smmu_init_context(struct arm_smmu_domain *smmu_domain,
 	return 0;
 }
 
+/*
+ * gaokun3 (SC8280XP) iris hardware video encoder: content-protection
+ * non-pixel context.
+ *
+ * The encoder firmware reaches its ARP (auto-register programming) PERSIST
+ * buffer through the CP non-pixel stream SID 0x2a04. That stream must
+ * translate through a stage-1 context bank whose CBAR VMID is 0xb
+ * (CP_NON_PIXEL) and whose page-table pages are assigned {HLOS RW, 0xb R}.
+ * The bank is CB15, as on Windows: binding 0x2a04 to another bank with the
+ * same VMID (the lowest free one was tried) hung the boot. This apps_smmu has
+ * no 16-bit VMIDs, so the VMID lives in CBAR[7:0] alone. Windows' qcsmmu8280
+ * sets this up from the host; mainline arm-smmu has no secure-VMID support,
+ * so build the bank here for this SoC's apps_smmu and let the iris driver map
+ * its ARP into it with qcom_iommu_cp_nonpixel_map(). The bank maps nothing
+ * until then.
+ */
+#define QCOM_CPNP_CB_IDX	15
+#define QCOM_CPNP_CBAR		0x0001a20b	/* S1 trans, VMID 0xb = CP_NON_PIXEL */
+#define QCOM_CPNP_SID		0x2a04
+#define QCOM_CPNP_SID_MASK	0x0400
+#define QCOM_VMID_CP_NON_PIXEL	0xb
+#define QCOM_CPNP_SMMU_BASE	0x15000000	/* the apps_smmu that serves iris */
+
+static struct {
+	struct arm_smmu_device	*smmu;	/* set once the bank is reserved */
+	struct io_pgtable_ops	*ops;	/* built lazily on the first map */
+	struct io_pgtable_cfg	cfg;
+	struct mutex		lock;
+} qcom_cpnp = { .lock = __MUTEX_INITIALIZER(qcom_cpnp.lock) };
+
+/* Table pages are shared with CP_NON_PIXEL, like qcsmmu8280 does. */
+static void *qcom_cpnp_pt_alloc(void *cookie, size_t size, gfp_t gfp)
+{
+	struct qcom_scm_vmperm perm[2] = {
+		{ QCOM_SCM_VMID_HLOS, QCOM_SCM_PERM_RW },
+		{ QCOM_VMID_CP_NON_PIXEL, QCOM_SCM_PERM_READ },
+	};
+	u64 src = BIT(QCOM_SCM_VMID_HLOS);
+	unsigned int order = get_order(size);
+	void *va;
+
+	va = (void *)__get_free_pages(gfp | __GFP_ZERO, order);
+	if (!va)
+		return NULL;
+	if (qcom_scm_assign_mem(virt_to_phys(va), PAGE_SIZE << order, &src,
+				perm, ARRAY_SIZE(perm))) {
+		free_pages((unsigned long)va, order);
+		return NULL;
+	}
+	return va;
+}
+
+static void qcom_cpnp_pt_free(void *cookie, void *pages, size_t size)
+{
+	struct qcom_scm_vmperm perm = { QCOM_SCM_VMID_HLOS, QCOM_SCM_PERM_RWX };
+	u64 src = BIT(QCOM_SCM_VMID_HLOS) | BIT(QCOM_VMID_CP_NON_PIXEL);
+	unsigned int order = get_order(size);
+
+	if (qcom_scm_assign_mem(virt_to_phys(pages), PAGE_SIZE << order, &src, &perm, 1)) {
+		dev_err(qcom_cpnp.smmu->dev, "cp-nonpixel: leaking table page\n");
+		return;
+	}
+	free_pages((unsigned long)pages, order);
+}
+
+static void qcom_cpnp_tlb_inv(struct arm_smmu_device *smmu)
+{
+	wmb();	/* table updates before the invalidation */
+	arm_smmu_cb_write(smmu, QCOM_CPNP_CB_IDX, ARM_SMMU_CB_S1_TLBIASID, QCOM_CPNP_CB_IDX);
+	qcom_smmu_tlb_sync(smmu, ARM_SMMU_CB(smmu, QCOM_CPNP_CB_IDX),
+			   ARM_SMMU_CB_TLBSYNC, ARM_SMMU_CB_TLBSTATUS);
+}
+
+static void qcom_cpnp_tlb_flush_all(void *cookie)
+{
+	qcom_cpnp_tlb_inv(qcom_cpnp.smmu);
+}
+
+static void qcom_cpnp_tlb_flush_walk(unsigned long iova, size_t size,
+				     size_t granule, void *cookie)
+{
+	qcom_cpnp_tlb_inv(qcom_cpnp.smmu);
+}
+
+static const struct iommu_flush_ops qcom_cpnp_tlb_ops = {
+	.tlb_flush_all	= qcom_cpnp_tlb_flush_all,
+	.tlb_flush_walk	= qcom_cpnp_tlb_flush_walk,
+};
+
+static irqreturn_t qcom_cpnp_fault(int irq, void *data)
+{
+	struct arm_smmu_device *smmu = qcom_cpnp.smmu;
+	u32 fsr = arm_smmu_cb_read(smmu, QCOM_CPNP_CB_IDX, ARM_SMMU_CB_FSR);
+
+	if (!(fsr & ARM_SMMU_CB_FSR_FAULT))
+		return IRQ_NONE;
+	dev_err_ratelimited(smmu->dev,
+			    "cp-nonpixel fault: fsr %#x far %#llx fsynr0 %#x cbfrsynra %#x\n",
+			    fsr, arm_smmu_cb_readq(smmu, QCOM_CPNP_CB_IDX, ARM_SMMU_CB_FAR),
+			    arm_smmu_cb_read(smmu, QCOM_CPNP_CB_IDX, ARM_SMMU_CB_FSYNR0),
+			    arm_smmu_gr1_read(smmu, ARM_SMMU_GR1_CBFRSYNRA(QCOM_CPNP_CB_IDX)));
+	arm_smmu_cb_write(smmu, QCOM_CPNP_CB_IDX, ARM_SMMU_CB_FSR, fsr);
+	return IRQ_HANDLED;
+}
+
+/*
+ * Write the whole bank. Called on the first map and again from the SoC reset
+ * path on every resume: a resume reset clears this bank (it has no normal
+ * cb->cfg), but the page table in RAM survives, so reprogramming the registers
+ * restores translation.
+ */
+static void qcom_cpnp_program(struct arm_smmu_device *smmu)
+{
+	struct io_pgtable_cfg *cfg = &qcom_cpnp.cfg;
+	u32 tcr = arm_smmu_lpae_tcr(cfg);
+	u32 tcr2 = arm_smmu_lpae_tcr2(cfg) | ARM_SMMU_TCR2_AS;
+	u64 asid = FIELD_PREP(ARM_SMMU_TTBRn_ASID, QCOM_CPNP_CB_IDX);
+	u32 sctlr = ARM_SMMU_SCTLR_CFIE | ARM_SMMU_SCTLR_CFRE | ARM_SMMU_SCTLR_AFE |
+		    ARM_SMMU_SCTLR_TRE | ARM_SMMU_SCTLR_M | ARM_SMMU_SCTLR_S1_ASIDPNE;
+
+	arm_smmu_cb_write(smmu, QCOM_CPNP_CB_IDX, ARM_SMMU_CB_SCTLR, 0);
+	arm_smmu_gr1_write(smmu, ARM_SMMU_GR1_CBA2R(QCOM_CPNP_CB_IDX), ARM_SMMU_CBA2R_VA64);
+	arm_smmu_gr1_write(smmu, ARM_SMMU_GR1_CBAR(QCOM_CPNP_CB_IDX), QCOM_CPNP_CBAR);
+	arm_smmu_cb_write(smmu, QCOM_CPNP_CB_IDX, ARM_SMMU_CB_TCR2, tcr2);
+	arm_smmu_cb_write(smmu, QCOM_CPNP_CB_IDX, ARM_SMMU_CB_TCR, tcr);
+	arm_smmu_cb_writeq(smmu, QCOM_CPNP_CB_IDX, ARM_SMMU_CB_TTBR0,
+			   cfg->arm_lpae_s1_cfg.ttbr | asid);
+	arm_smmu_cb_writeq(smmu, QCOM_CPNP_CB_IDX, ARM_SMMU_CB_TTBR1, asid);
+	arm_smmu_cb_write(smmu, QCOM_CPNP_CB_IDX, ARM_SMMU_CB_S1_MAIR0,
+			  lower_32_bits(cfg->arm_lpae_s1_cfg.mair));
+	arm_smmu_cb_write(smmu, QCOM_CPNP_CB_IDX, ARM_SMMU_CB_S1_MAIR1,
+			  upper_32_bits(cfg->arm_lpae_s1_cfg.mair));
+	arm_smmu_cb_write(smmu, QCOM_CPNP_CB_IDX, ARM_SMMU_CB_FSR, ARM_SMMU_CB_FSR_FAULT);
+	qcom_cpnp_tlb_inv(smmu);
+	arm_smmu_cb_write(smmu, QCOM_CPNP_CB_IDX, ARM_SMMU_CB_SCTLR, sctlr);
+}
+
+static int qcom_cpnp_init(struct arm_smmu_device *smmu)
+{
+	struct io_pgtable_cfg *cfg = &qcom_cpnp.cfg;
+	int irq, ret;
+
+	*cfg = (struct io_pgtable_cfg) {
+		.pgsize_bitmap	= smmu->pgsize_bitmap,
+		.ias		= smmu->va_size,
+		.oas		= smmu->ipa_size,
+		.coherent_walk	= smmu->features & ARM_SMMU_FEAT_COHERENT_WALK,
+		.tlb		= &qcom_cpnp_tlb_ops,
+		.iommu_dev	= smmu->dev,
+		.alloc		= qcom_cpnp_pt_alloc,
+		.free		= qcom_cpnp_pt_free,
+	};
+	qcom_cpnp.ops = alloc_io_pgtable_ops(ARM_64_LPAE_S1, cfg, &qcom_cpnp);
+	if (!qcom_cpnp.ops)
+		return -ENOMEM;
+
+	if (QCOM_CPNP_CB_IDX < smmu->num_context_irqs) {
+		irq = smmu->irqs[QCOM_CPNP_CB_IDX];
+		ret = devm_request_irq(smmu->dev, irq, qcom_cpnp_fault, IRQF_SHARED,
+				       "qcom-cp-nonpixel", &qcom_cpnp);
+		if (ret)
+			dev_warn(smmu->dev, "cp-nonpixel: no fault irq %d: %d\n", irq, ret);
+	}
+	return 0;
+}
+
+/* True once the CP non-pixel bank is reserved on this SoC's apps_smmu. */
+bool qcom_iommu_cp_nonpixel_available(void)
+{
+	return qcom_cpnp.smmu != NULL;
+}
+EXPORT_SYMBOL_GPL(qcom_iommu_cp_nonpixel_available);
+
+/*
+ * Map @size bytes of @pa at @iova in the CP non-pixel bank and (re)program the
+ * bank. @iova must lie in the content-protection window; the caller assigns
+ * the pages to CP_NON_PIXEL first. The mapping is removed with the unmap.
+ */
+int qcom_iommu_cp_nonpixel_map(unsigned long iova, phys_addr_t pa, size_t size)
+{
+	struct arm_smmu_device *smmu = qcom_cpnp.smmu;
+	size_t mapped = 0;
+	int ret;
+
+	if (!smmu)
+		return -ENODEV;
+
+	mutex_lock(&qcom_cpnp.lock);
+	if (!qcom_cpnp.ops) {
+		ret = qcom_cpnp_init(smmu);
+		if (ret)
+			goto out;
+	}
+	ret = qcom_cpnp.ops->map_pages(qcom_cpnp.ops, iova, pa, SZ_4K, size / SZ_4K,
+				       IOMMU_READ | IOMMU_WRITE, GFP_KERNEL, &mapped);
+	if (ret) {
+		if (mapped)
+			qcom_cpnp.ops->unmap_pages(qcom_cpnp.ops, iova, SZ_4K,
+						   mapped / SZ_4K, NULL);
+		goto out;
+	}
+	qcom_cpnp_program(smmu);
+out:
+	mutex_unlock(&qcom_cpnp.lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(qcom_iommu_cp_nonpixel_map);
