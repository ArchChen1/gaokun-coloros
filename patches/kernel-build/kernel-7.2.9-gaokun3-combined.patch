+static u32 vfe17x_next_outputs(struct vfe_device *vfe);
+static bool vfe17x_outputs_ready(struct vfe_device *vfe, u32 outputs);
+static void vfe17x_arm_outputs(struct vfe_device *vfe, u32 outputs);
