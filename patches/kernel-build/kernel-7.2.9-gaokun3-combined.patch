+/* The RDI lines with their link on, by line id */
+static u8 vfe_rdi_linked(struct vfe_device *vfe)
+{
+	unsigned int i;
+	u8 linked = 0;
+
+	for (i = 0; i < vfe->res->line_num; i++)
+		if (i != VFE_LINE_PIX &&
+		    media_pad_remote_pad_first(&vfe->line[i].pads[MSM_VFE_PAD_SINK]))
+			linked |= BIT(i);
