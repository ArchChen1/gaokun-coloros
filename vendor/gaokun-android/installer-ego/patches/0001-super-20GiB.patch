+# 说明：上游的 installer-windows.yml 用 windows-11-arm 运行器（私有仓库拿不到 ARM 运行器），
+# 这里给私有仓库准备一条 x64 备用流水线：产物是 x64 的 Windows 安装器，在平板的 Windows 侧
+# 由 Windows-on-ARM 的 x64 模拟运行（功能相同，启动稍慢）。
+# 发布时若要用原生 ARM64 版，把仓库转公开或给组织开 ARM 运行器，直接用上游的 installer-windows.yml。
+
+name: EGO installer (x64)
+
+on:
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+env:
+  FLUTTER_VERSION: '3.47.2'
+  PYTHONUTF8: '1'
+  LLVM_MINGW_NAME: llvm-mingw-20261104-ucrt-ubuntu-22.04-x86_64
+  LLVM_MINGW_SHA256: 919380403de87dca3c581c2053230cd298af5e891286628ba0613b7fed370926
+
+jobs:
+  backend:
+    name: gk3w + mke2fs + systemd-boot (x64)
+    runs-on: ubuntu-24.04
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+      - name: llvm-mingw
+        run: |
+          curl -fsSL --retry 3 -o /tmp/llvm-mingw.tar.xz \
+            "https://github.com/mstorsjo/llvm-mingw/releases/download/20261104/$LLVM_MINGW_NAME.tar.xz"
+          echo "$LLVM_MINGW_SHA256  /tmp/llvm-mingw.tar.xz" | sha256sum -c
+          mkdir -p "$HOME/opt" && tar -C "$HOME/opt" -xf /tmp/llvm-mingw.tar.xz
+          echo "LLVM_MINGW=$HOME/opt/$LLVM_MINGW_NAME" >> "$GITHUB_ENV"
+      - name: host unit tests
+        run: make -C installer/backend test
+      - name: build backend
+        run: |
+          make -C installer/backend win-x64 sdboot GK3W_VERSION='dev-${GITHUB_SHA::7}'
+          bash installer/backend/mke2fs/build.sh x64
+      - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
+        with:
+          name: backend-x64
+          if-no-files-found: error
+          path: |
+            installer/backend/build/x64/gk3w.exe
+            installer/backend/build/mke2fs-x64/mke2fs.exe
+            installer/backend/build/mke2fs-x64/mke2fs.conf
+            installer/backend/build/sdboot/systemd-bootaa64.efi
+
+  app:
+    name: app (x64)
+    needs: backend
+    runs-on: windows-latest
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+      - uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333 # v8.0.2
+        with:
+          name: backend-x64
+          path: installer/backend/build
+      - name: flutter
+        shell: pwsh
+        run: |
+          git clone --quiet --depth 1 --branch $env:FLUTTER_VERSION https://github.com/flutter/flutter.git C:\flutter
+          "C:\flutter\bin" | Out-File -FilePath $env:GITHUB_PATH -Encoding utf8 -Append
+      - name: fonts
+        shell: pwsh
+        run: python installer/common/tool/fetch-fonts.py
+      - name: build
+        shell: pwsh
+        working-directory: installer/windows
+        run: |
+          flutter --disable-analytics
+          flutter config --enable-windows-desktop
+          flutter pub get
+          flutter build windows --release --dart-define=GK3_VERSION=dev-$($env:GITHUB_SHA.Substring(0,7))
+      - name: check the bundle
+        shell: pwsh
+        run: |
+          $rel = "installer/windows/build/windows/x64/runner/Release"
+          foreach ($f in 'gk3_windows.exe', 'backend/gk3w.exe', 'backend/mke2fs.exe', 'backend/mke2fs.conf', 'backend/systemd-bootaa64.efi') {
+            if (-not (Test-Path "$rel/$f")) { throw "missing $rel/$f" }
+          }
+          foreach ($f in 'gk3_windows.exe', 'backend/gk3w.exe', 'backend/mke2fs.exe') {
+            $m = [System.IO.File]::ReadAllBytes((Resolve-Path "$rel/$f"))
+            $machine = [BitConverter]::ToUInt16($m, [BitConverter]::ToInt32($m, 0x3c) + 4)
+            if ($machine -ne 0x8664) { throw ("{0}: machine 0x{1:X4}, want 0x8664" -f $f, $machine) }
+          }
+      - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
+        with:
+          name: ego-installer-windows-x64
+          if-no-files-found: error
+          path: installer/windows/build/windows/x64/runner/Release/
