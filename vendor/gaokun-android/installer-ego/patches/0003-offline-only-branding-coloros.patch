-  Gk3Record? mftResult;
-  Gk3Record? mftErr;
-
-  /// 移动 MFT，成功后重新分析可压缩空间
-  Future<void> moveMft() async {
-    if (mftMoving || shrinkChecking || bitlockerChecking) return;
-    mftMoving = true;
-    mftResult = null;
-    mftErr = null;
-    notifyListeners();
-    try {
-      // 原生窗口确认已经挡住关闭与关机，才启动 gk3w（同写盘）
-      await beforeDiskWrite?.call();
