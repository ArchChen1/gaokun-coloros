-      plans.clear();
-      region = null;
-      mediaTarget = null;
-      mediaRegion = _defaultMediaRegion();
-      if (disk != null && !installed) await _loadPlans();
-    } catch (e) {
-      logNote?.call('!! $e');
-      if (gen != _checkGen) return;
-      checkErr = _failed('check');
-      log.add('!! $e');
-    } finally {
-      if (gen == _checkGen) {
-        checking = false;
-        notifyListeners();
-      }
-    }
-  }
